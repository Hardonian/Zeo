f:T4142,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Run &amp; Replay Manager</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#13a4ec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101c22",
                        "card-dark": "#18262e",
                        "card-border": "#283339",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
        /* Custom scrollbar for better look on dark theme */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #101c22;
        }
        ::-webkit-scrollbar-thumb {
            background: #283339;
            border-radius: 3px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #3b4b54;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display text-gray-900 dark:text-white antialiased overflow-x-hidden pb-20">
<!-- Header -->
<header class="sticky top-0 z-50 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-md border-b border-gray-200 dark:border-card-border px-4 py-3 flex items-center justify-between shadow-sm">
<div>
<h1 class="text-lg font-bold leading-tight tracking-tight">Run &amp; Replay Manager</h1>
<p class="text-xs text-gray-500 dark:text-gray-400">System Monitoring Dashboard</p>
</div>
<div class="flex gap-2">
<button class="flex items-center justify-center w-10 h-10 rounded-lg text-gray-500 hover:bg-gray-200 dark:text-gray-400 dark:hover:bg-card-border transition-colors">
<span class="material-symbols-outlined">search</span>
</button>
<button class="flex items-center justify-center w-10 h-10 rounded-lg text-gray-500 hover:bg-gray-200 dark:text-gray-400 dark:hover:bg-card-border transition-colors">
<span class="material-symbols-outlined">filter_list</span>
</button>
</div>
</header>
<!-- Metrics Summary -->
<section class="px-4 py-4 grid grid-cols-2 gap-3">
<!-- Active Runs -->
<div class="bg-white dark:bg-card-dark border border-gray-200 dark:border-card-border rounded-lg p-3 flex flex-col justify-between shadow-sm">
<div class="flex items-start justify-between">
<span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Active Runs</span>
<span class="text-emerald-500 text-xs font-bold bg-emerald-500/10 px-1.5 py-0.5 rounded">+2</span>
</div>
<div class="mt-2 flex items-baseline gap-1">
<span class="text-2xl font-bold">12</span>
<span class="text-xs text-gray-400">Total</span>
</div>
</div>
<!-- System Status -->
<div class="bg-white dark:bg-card-dark border border-gray-200 dark:border-card-border rounded-lg p-3 flex flex-col justify-between shadow-sm">
<div class="flex items-start justify-between">
<span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Status</span>
<span class="text-primary text-xs font-bold bg-primary/10 px-1.5 py-0.5 rounded">98%</span>
</div>
<div class="mt-2 flex items-center gap-2">
<div class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></div>
<span class="text-lg font-bold">Stable</span>
</div>
</div>
<!-- Avg Uncertainty -->
<div class="col-span-2 bg-white dark:bg-card-dark border border-gray-200 dark:border-card-border rounded-lg p-3 flex items-center justify-between shadow-sm">
<div class="flex flex-col">
<span class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Avg Uncertainty</span>
<span class="text-xl font-bold mt-0.5">4.2%</span>
</div>
<!-- Simple sparkline visualization -->
<div class="flex items-end h-8 gap-1">
<div class="w-1.5 bg-gray-200 dark:bg-gray-700 h-3 rounded-sm"></div>
<div class="w-1.5 bg-gray-200 dark:bg-gray-700 h-5 rounded-sm"></div>
<div class="w-1.5 bg-primary/40 h-4 rounded-sm"></div>
<div class="w-1.5 bg-primary/60 h-7 rounded-sm"></div>
<div class="w-1.5 bg-primary h-6 rounded-sm"></div>
</div>
</div>
</section>
<!-- List Section -->
<main class="px-4 pb-20 space-y-4">
<div class="flex items-center justify-between pt-2">
<h2 class="text-base font-bold text-gray-800 dark:text-white">Recent Runs</h2>
<button class="text-xs font-medium text-primary hover:text-primary/80">View All</button>
</div>
<!-- Run Card 1: Completed, High Rank -->
<article class="bg-white dark:bg-card-dark border border-gray-200 dark:border-card-border rounded-xl p-4 shadow-sm relative overflow-hidden group">
<div class="absolute top-0 left-0 w-1 h-full bg-emerald-500"></div>
<!-- Header Row -->
<div class="flex justify-between items-start mb-3 pl-2">
<div>
<div class="flex items-center gap-2">
<h3 class="font-mono text-lg font-bold text-gray-900 dark:text-white">Run #8821</h3>
<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-emerald-100 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-500/30">Completed</span>
</div>
