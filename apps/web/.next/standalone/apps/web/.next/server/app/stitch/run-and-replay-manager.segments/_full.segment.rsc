<span class="text-sm font-bold text-gray-700 dark:text-gray-300">2.4%</span>
</div>
<div class="bg-gray-50 dark:bg-[#111618] rounded p-2 flex flex-col items-center justify-center border border-gray-100 dark:border-gray-800">
<span class="text-[10px] text-gray-500 uppercase tracking-tight">Regret</span>
<span class="text-sm font-bold text-gray-700 dark:text-gray-300">0.05</span>
</div>
</div>
<!-- Action Bar -->
<div class="flex items-center gap-2 pl-2">
<button class="flex-1 bg-primary hover:bg-primary/90 text-white text-xs font-bold py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-colors">
<span class="material-symbols-outlined text-[16px]">play_arrow</span>
                    Replay
                </button>
<button class="flex-1 bg-gray-100 dark:bg-[#283339] hover:bg-gray-200 dark:hover:bg-[#3b4b54] text-gray-700 dark:text-gray-300 text-xs font-bold py-2 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-colors">
<span class="material-symbols-outlined text-[16px]">difference</span>
                    Diff
                </button>
<button class="w-9 h-9 flex items-center justify-center bg-gray-100 dark:bg-[#283339] hover:bg-gray-200 dark:hover:bg-[#3b4b54] text-gray-500 dark:text-gray-400 rounded-lg transition-colors">
<span class="material-symbols-outlined text-[18px]">ios_share</span>
</button>
</div>
</article>
<!-- Run Card 2: Flagged, Negative Rank -->
<article class="bg-white dark:bg-card-dark border border-gray-200 dark:border-card-border rounded-xl p-4 shadow-sm relative overflow-hidden group">
