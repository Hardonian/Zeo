{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/runtime/layout,_N_T_/runtime/page,_N_T_/runtime"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/runtime/__PAGE__",
    "/runtime",
    "/_index",
    "/_head"
  ]
}