f:T2ef4,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Explanation Consistency Checker</title>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "primary": "#137fec",
              "background-light": "#f6f7f8",
              "background-dark": "#101922",
              "card-dark": "#1c252e",
              "tag-contradiction": "#ef4444",
              "tag-overconfident": "#f59e0b",
              "tag-verified": "#10b981",
            },
            fontFamily: {
              "display": ["Inter", "sans-serif"]
            },
            borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
          },
        },
      }
    </script>
<style>
        /* Custom scrollbar for better mobile feel inside containers */
        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: #4b5563;
            border-radius: 20px;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-white min-h-screen flex flex-col overflow-hidden">
<!-- Header -->
<header class="flex items-center justify-between p-4 bg-white dark:bg-[#111418] border-b border-gray-200 dark:border-gray-800 shrink-0 z-10 sticky top-0">
<div class="flex items-center gap-3">
<button aria-label="Go back" class="flex items-center justify-center p-2 rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 text-gray-600 dark:text-gray-300 transition-colors">
<span class="material-symbols-outlined" style="font-size: 24px;">arrow_back</span>
</button>
<h1 class="text-lg font-bold leading-tight tracking-tight">Consistency Audit</h1>
</div>
<div class="flex items-center gap-2">
<span class="flex h-2 w-2 rounded-full bg-green-500"></span>
<span class="text-xs font-medium text-gray-500 dark:text-gray-400">Analysis Complete</span>
</div>
</header>
<!-- Main Content Area -->
<main class="flex-1 flex flex-col overflow-y-auto relative custom-scrollbar pb-24">
<!-- View Toggle (Segmented Control) -->
<div class="px-4 py-4 sticky top-0 bg-background-light dark:bg-background-dark z-10 backdrop-blur-sm bg-opacity-95 dark:bg-opacity-95">
<div class="flex p-1 bg-gray-200 dark:bg-[#283039] rounded-lg">
<button class="flex-1 py-1.5 px-3 rounded-md bg-white dark:bg-[#111418] shadow-sm text-sm font-medium text-gray-900 dark:text-white transition-all text-center">
                    Split View
                </button>
<button class="flex-1 py-1.5 px-3 rounded-md text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-all text-center">
                    Original
                </button>
<button class="flex-1 py-1.5 px-3 rounded-md text-sm font-medium text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-all text-center">
                    Diff
                </button>
</div>
</div>
<!-- Info Bar -->
<div class="px-4 mb-4 flex justify-between items-center text-xs text-gray-500 dark:text-gray-400">
<span>Model: GPT-4o-gov-compliance-v2.4</span>
<span>ID: #REQ-9921</span>
</div>
<!-- Split Content Container -->
<div class="flex flex-col gap-6 px-4">
<!-- Executive Summary Card -->
<section aria-labelledby="exec-summary-title" class="bg-white dark:bg-card-dark rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden">
<div class="p-4 border-b border-gray-100 dark:border-gray-700/50 flex justify-between items-center bg-gray-50 dark:bg-white/5">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary" style="font-size: 20px;">description</span>
<h2 class="font-semibold text-sm tracking-wide uppercase text-gray-500 dark:text-gray-400" id="exec-summary-title">Executive Summary</h2>
</div>
<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-100 dark:bg-red-900/30 text-red-600 dark:text-red-400 border border-red-200 dark:border-red-800/50">1 CONTRADICTION</span>
</div>
<div class="p-5 text-sm leading-relaxed text-gray-700 dark:text-gray-300 font-normal">
<p class="mb-4">
                        The system has reviewed the transaction request initiated by User ID <span class="font-mono bg-gray-100 dark:bg-black/30 px-1 rounded">88392</span>. Based on the historical interaction patterns and current session metadata, the model suggests that the transaction was secure and authorized.
                    </p>
<p class="mb-4 relative">
<span class="bg-red-50 dark:bg-red-900/20 px-1 rounded-sm border-l-2 border-red-500 py-0.5">
                            However, recent login patterns show no anomalies, and the device fingerprint matches previous trusted sessions.
                        </span>
<button aria-label="View contradiction details" class="inline-flex items-center gap-1 align-middle ml-1 px-1.5 py-0.5 rounded-full bg-tag-contradiction text-white text-[10px] font-bold tracking-wider hover:bg-red-600 transition-colors focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            CONTRADICTION
                            <span class="material-symbols-outlined" style="font-size: 12px;">info</span>
</button>
</p>
<p>
                        Therefore, no further authentication steps are recommended at this stage. The confidence level for this assessment is high.
                        <button aria-label="View overconfidence details" class="inline-flex items-center gap-1 align-middle ml-1 px-1.5 py-0.5 rounded-full bg-tag-overconfident text-black text-[10px] font-bold tracking-wider hover:bg-amber-400 transition-colors">
                            OVERCONFIDENT
                            <span class="material-symbols-outlined" style="font-size: 12px;">warning</span>
</button>
</p>
</div>
</section>
<!-- Technical Output Card -->
<section aria-labelledby="tech-output-title" class="bg-white dark:bg-card-dark rounded-xl shadow-sm border border-gray-200 dark:border-gray-800 overflow-hidden mb-6">
<div class="p-4 border-b border-gray-100 dark:border-gray-700/50 flex justify-between items-center bg-gray-50 dark:bg-white/5">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-gray-500" style="font-size: 20px;">terminal</span>
<h2 class="font-semibold text-sm tracking-wide uppercase text-gray-500 dark:text-gray-400" id="tech-output-title">Technical Output</h2>
</div>
<span class="text-[10px] font-mono text-gray-400">JSON RAW</span>
</div>
<div class="p-5 bg-[#0d1117] overflow-x-auto">
<pre class="text-xs font-mono leading-relaxed"><code class="text-gray-300"><span class="text-purple-400">"analysis_id"</span>: <span class="text-green-400">"evt_9921_alpha"</span>,
<span class="text-purple-400">"risk_assessment"</span>: {
  <span class="text-purple-400">"score"</span>: <span class="text-orange-400">0.85</span>,
  <span class="text-purple-400">"flags"</span>: [
    <span class="text-green-400">"geo_velocity_anomaly"</span>, 
    <span class="text-green-400">"new_device_fingerprint"</span>
  ]
},
<span class="text-gray-500">// Contradictory evidence found below</span>
<span class="text-purple-400">"logic_trace"</span>: {
  <span class="text-purple-400">"assertion"</span>: <span class="text-green-400">"User location mismatch: IP (Russia) != Profile (USA)"</span>,
  <span class="text-purple-400">"confidence_logit"</span>: <span class="text-orange-400">0.42</span>
}</code></pre>
</div>
<!-- Highlighted Connection -->
<div class="p-3 bg-red-500/10 border-t border-red-500/20 text-xs text-red-400 flex gap-2 items-start">
<span class="material-symbols-outlined shrink-0 mt-0.5" style="font-size: 16px;">link_off</span>
<p>Mismatch: Technical output flags "geo_velocity_anomaly" and "new_device_fingerprint", but Summary claims "fingerprint matches".</p>
</div>
</section>
</div>
</main>
<!-- Bottom Action Bar (Fixed) -->
<div class="bg-white dark:bg-[#111418] border-t border-gray-200 dark:border-gray-800 p-4 shrink-0 safe-pb-4 z-20 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.1)]">
<div class="flex gap-3 max-w-lg mx-auto">
<button class="flex-1 h-12 flex items-center justify-center gap-2 rounded-lg border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 font-semibold hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors">
<span class="material-symbols-outlined" style="font-size: 20px;">flag</span>
                Flag Issue
            </button>
<button class="flex-1 h-12 flex items-center justify-center gap-2 rounded-lg bg-primary text-white font-semibold shadow-lg shadow-blue-500/20 hover:bg-blue-600 transition-colors">
<span class="material-symbols-outlined" style="font-size: 20px;">check_circle</span>
                Approve
            </button>
</div>
</div>
<!-- Detail Panel / Bottom Sheet (Hidden by default, simulating visible state for demo purposes) -->
<!-- In a real app, this would be triggered by clicking the tag -->
<div class="fixed inset-0 z-50 pointer-events-none flex flex-col justify-end">
<!-- Backdrop -->
<div class="absolute inset-0 bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300" id="backdrop"></div>
<!-- Sheet -->
<!-- Add 'translate-y-0 opacity-100 pointer-events-auto' to show, remove 'translate-y-full opacity-0 pointer-events-none' -->
<div class="bg-white dark:bg-[#1e2630] w-full rounded-t-2xl p-6 shadow-2xl transform translate-y-full transition-transform duration-300 ease-out border-t border-gray-700/50 pointer-events-auto" style="display: none;"> <!-- Hidden for initial render cleanliness, purely representative structure -->
<div class="w-12 h-1.5 bg-gray-300 dark:bg-gray-600 rounded-full mx-auto mb-6"></div>
<div class="flex items-center gap-3 mb-4">
<div class="p-2 bg-red-100 dark:bg-red-900/30 rounded-lg text-red-600 dark:text-red-400">
<span class="material-symbols-outlined">gpp_bad</span>
</div>
<div>
<h3 class="text-lg font-bold text-gray-900 dark:text-white">Contradiction Detected</h3>
<p class="text-sm text-gray-500 dark:text-gray-400">Confidence Score: 98% (Unwarranted)</p>
</div>
</div>
<div class="bg-background-light dark:bg-background-dark rounded-lg p-4 mb-6 border border-gray-200 dark:border-gray-700">
<p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">
                    The summary claims the device fingerprint matches, but the technical log explicitly lists <code class="text-primary font-mono text-xs">new_device_fingerprint</code> in the risk assessment flags.
                </p>
</div>
<button class="w-full py-3 rounded-lg bg-primary text-white font-semibold mb-2">Confirm Discrepancy</button>
<button class="w-full py-3 rounded-lg bg-transparent text-gray-500 hover:text-gray-700 dark:hover:text-gray-300 font-medium">Dismiss</button>
</div>
</div>
<!-- Floating "Regenerate" Action Button (FAB) -->
<button aria-label="Regenerate Analysis" class="fixed bottom-24 right-4 z-10 p-3 bg-white dark:bg-card-dark text-primary rounded-full shadow-lg border border-gray-200 dark:border-gray-700 hover:scale-105 transition-transform group">
<span class="material-symbols-outlined group-hover:animate-spin">autorenew</span>
</button>
