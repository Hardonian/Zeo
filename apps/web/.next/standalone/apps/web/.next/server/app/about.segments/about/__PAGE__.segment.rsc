0:{"buildId":"8ZfsPSrfgPx8SRye8yuF4","rsc":["$","$1","c",{"children":[["$","$L2",null,{"title":"About Zeo","children":["$","div",null,{"className":"max-w-3xl space-y-8","children":[["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold mb-3","children":"Mission"}],["$","p",null,{"className":"text-gray-700 leading-relaxed","children":"Zeo is an evidence-mapping workspace for decisions made under uncertainty. Unlike traditional decision tools that optimize for certainty, Zeo makes uncertainty a first-class citizen — tracking confidence ranges, assumptions, and the sensitivity of conclusions to new evidence."}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold mb-3","children":"Core Principles"}],["$","div",null,{"className":"space-y-4","children":[["$","div",null,{"className":"border-l-4 border-blue-500 pl-4","children":[["$","h3",null,{"className":"font-medium","children":"Epistemic Honesty"}],["$","p",null,{"className":"text-sm text-gray-600 mt-1","children":"Never convert uncertainty into false precision. Facts, beliefs, and assumptions are clearly distinguished."}]]}],["$","div",null,{"className":"border-l-4 border-blue-500 pl-4","children":[["$","h3",null,{"className":"font-medium","children":"Provenance-First"}],["$","p",null,{"className":"text-sm text-gray-600 mt-1","children":"Every extracted fact carries its source, timestamp, and confidence. Without provenance, claims are marked as assumptions or beliefs."}]]}],["$","div",null,{"className":"border-l-4 border-blue-500 pl-4","children":[["$","h3",null,{"className":"font-medium","children":"Robustness Over Recommendation"}],["$","p",null,{"className":"text-sm text-gray-600 mt-1","children":"Prefer outputs that are robust across assumptions rather than a single \"best choice.\" Sensitivity analysis shows what would change the answer."}]]}],["$","div",null,{"className":"border-l-4 border-blue-500 pl-4","children":[["$","h3",null,{"className":"font-medium","children":"Privacy-First Defaults"}],["$","p",null,{"className":"text-sm text-gray-600 mt-1","children":"Edge-first processing when feasible. Raw data is minimized; extracted artifacts and provenance are stored instead."}]]}]]}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold mb-3","children":"What Zeo Includes"}],["$","ul",null,{"className":"space-y-2 text-gray-700","children":[["$","li",null,{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-blue-600 mt-1","children":"•"}],["$","span",null,{"children":[["$","strong",null,{"children":"Decision Branching Engine:"}]," Explore decision trees with sensitivity analysis and flip thresholds."]}]]}],["$","li",null,{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-blue-600 mt-1","children":"•"}],["$","span",null,{"children":[["$","strong",null,{"children":"Evidence Ingestion:"}]," Structured adapters for OCR, audio, and computer vision inputs."]}]]}],["$","li",null,{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-blue-600 mt-1","children":"•"}],["$","span",null,{"children":[["$","strong",null,{"children":"Uncertainty Ledger:"}]," Track confidence ranges and how they evolve with new evidence."]}]]}],["$","li",null,{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-blue-600 mt-1","children":"•"}],["$","span",null,{"children":[["$","strong",null,{"children":"Epistemic Translator:"}]," Convert between different reasoning frameworks and vocabularies."]}]]}],["$","li",null,{"className":"flex items-start gap-2","children":[["$","span",null,{"className":"text-blue-600 mt-1","children":"•"}],["$","span",null,{"children":[["$","strong",null,{"children":"Governance Dashboards:"}]," OSS governance, KPI monitoring, and audit trails."]}]]}]]}]]}],["$","section",null,{"children":[["$","h2",null,{"className":"text-lg font-semibold mb-3","children":"Exp