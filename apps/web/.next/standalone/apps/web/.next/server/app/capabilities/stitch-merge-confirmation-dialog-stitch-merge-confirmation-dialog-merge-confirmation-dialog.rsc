<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen relative overflow-hidden transition-colors duration-200">
<div aria-hidden="true" class="pb-32 opacity-50 blur-[1px] select-none pointer-events-none">
<header class="flex items-center justify-between px-4 py-3 bg-surface-light dark:bg-surface-dark border-b border-slate-200 dark:border-slate-800">
<div class="flex items-center gap-2">
<div class="w-6 h-6 bg-slate-900 dark:bg-white rounded-full flex items-center justify-center">
<span class="material-icons-round text-white dark:text-slate-900 text-sm">layers</span>
</div>
<span class="font-bold text-sm tracking-tight">READYLAYER</span>
</div>
<div class="flex items-center gap-3">
<span class="text-xs font-medium text-slate-500 dark:text-slate-400">View Docs</span>
<button class="bg-primary text-white text-xs font-medium px-3 py-1.5 rounded-full">See GitHub</button>
</div>
</header>
<main class="p-4 space-y-6">
<div class="space-y-2">
<div class="flex items-center gap-2 text-slate-500 dark:text-slate-400 text-xs">
<span>ReadyLayer/core-api</span>
<span>#842</span>
</div>
<h1 class="text-xl font-bold leading-tight">feat: Stripe payment gateway integration v2</h1>
<div class="flex items-center gap-2 mt-2">
<span class="bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs px-2 py-0.5 rounded-full font-medium border border-green-200 dark:border-green-800">Open</span>
<span class="text-xs text-slate-500 dark:text-slate-400">opened 4 hours ago by <span class="font-medium text-slate-800 dark:text-slate-200">alex-dev</span></span>
</div>
</div>
<div class="bg-surface-light dark:bg-surface-dark rounded-xl border border-slate-200 dark:border-slate-800 p-4">
<h2 class="text-sm font-semibold mb-3">Checks</h2>
<div class="space-y-3">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-icons-round text-green-500 text-base">check_circle</span>
<span class="text-sm">Build &amp; Test</span>
</div>
<span class="text-xs text-slate-500">Passed</span>
</div>
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-icons-round text-green-500 text-base">check_circle</span>
<span class="text-sm">Linting</span>
</div>
<span class="text-xs text-slate-500">Passed</span>
</div>
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-icons-round text-amber-500 text-base">warning</span>
<span class="text-sm font-medium">ReadyLayer Audit</span>
</div>
<span class="text-xs text-amber-600 dark:text-amber-400 font-medium">Risks found</span>
</div>
</div>
</div>
<div class="space-y-3">
<h2 class="text-sm font-semibold px-1">Files changed (12)</h2>
<div class="h-24 bg-slate-200 dark:bg-slate-800 rounded-lg w-full animate-pulse"></div>
<div class="h-16 bg-slate-200 dark:bg-slate-800 rounded-lg w-full animate-pulse"></div>
</div>
<div class="fixed bottom-0 left-0 right-0 p-4 bg-surface-light dark:bg-surface-dark border-t border-slate-200 dark:border-slate-800">
<button class="w-full bg-green-600 text-white font-bold py-3 rounded-lg shadow-lg">Merge Pull Request</button>
</div>
</main>
</div>
<div class="fixed inset-0 z-50 flex flex-col justify-end sm:justify-center items-center sm:p-4">
<div aria-hidden="true" class="absolute inset-0 bg-slate-900/40 dark:bg-black/60 backdrop-blur-sm transition-opacity"></div>
<div class="relative w-full max-w-md bg-surface-light dark:bg-surface-dark rounded-t-3xl sm:rounded-2xl shadow-up sm:shadow-2xl transform transition-all overflow-hidden flex flex-col max-h-[90vh]">
<div class="w-full flex justify-center pt-3 pb-1 sm:hidden">
<div class="w-12 h-1.5 bg-slate-300 dark:bg-slate-600 rounded-full"></div>
</div>
<div class="px-6 pt-5 pb-2 text-center">
<div class="mx-auto w-12 h-12 bg-indigo-50 dark:bg-indigo-900/30 rounded-full flex items-center justify-center mb-4">
<span class="material-icons-round text-primary text-2xl">security</span> 
</div>
<h2 class="text-xl font-bold text-slate-900 dark:text-white">Merge Check</h2>
<p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                    ReadyLayer found potential risks in this PR.
                </p>
</div>
<div class="px-6 py-4 overflow-y-auto">
<div class="space-y-3">
<div class="bg-amber-50 dark:bg-amber-900/10 border border-amber-100 dark:border-amber-900/30 rounded-xl p-4 flex items-start gap-3">
<span class="material-icons-round text-amber-500 mt-0.5 text-lg">alt_route</span>
<div>
<h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200">Uncovered Logic Paths</h3>
<p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">
                                Several conditional branches in the checkout flow lack unit tests.
                            </p>
</div>
</div>
<div class="bg-slate-50 dark:bg-slate-800/50 border border-slate-100 dark:border-slate-700/50 rounded-xl p-4 flex items-start gap-3">
<span class="material-icons-round text-slate-400 mt-0.5 text-lg">integration_instructions</span>
<div>
<h3 class="text-sm font-semibold text-slate-800 dark:text-slate-200">Unverified Workflows</h3>
<p class="text-xs text-slate-600 dark:text-slate-400 mt-0.5 leading-relaxed">
                                Payment gateway integration changes have not been fully simulated.
                            </p>
</div>
</div>
</div>
</div>
<div class="p-6 pt-2 pb-8 sm:pb-6 bg-surface-light dark:bg-surface-dark border-t border-slate-100 dark:border-slate-800/50 flex flex-col gap-3">
<button class="w-full bg-primary hover:bg-primary-dark text-white font-semibold py-3.5 px-4 rounded-xl shadow-lg shadow-blue-500/20 dark:shadow-blue-900/20 flex items-center justify-center gap-2 transition-transform active:scale-[0.98]">
<span class="material-icons-round text-lg">play_circle</span>
                    Run Verification Now
                </button>
<button class="w-full bg-transparent hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-500 dark:text-slate-400 font-medium py-3 px-4 rounded-xl border border-transparent hover:border-slate-200 dark:hover:border-slate-700 transition-colors text-sm">
                    Proceed Anyway
                </button>
</div>
</div>
</div>

