{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/docs/layout,_N_T_/docs/github/layout,_N_T_/docs/github/page,_N_T_/docs/github"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/docs/github/__PAGE__",
    "/docs/github",
    "/docs",
    "/_index",
    "/_head"
  ]
}