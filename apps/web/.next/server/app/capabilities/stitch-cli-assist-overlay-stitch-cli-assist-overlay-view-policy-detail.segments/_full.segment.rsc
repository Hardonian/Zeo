f:T1d67,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Policy Detail - Keys Developer Tool</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#135bec",
                        "background-light": "#f6f6f8",
                        "background-dark": "#101622",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk"]
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                },
            },
        }
    </script>
<style>
        body {
            font-family: 'Space Grotesk', sans-serif;
        }
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex items-center justify-center p-0 sm:p-4">
<!-- Main Container (Simulating a full screen or focused view) -->
<div class="relative w-full max-w-2xl h-full sm:h-auto min-h-screen sm:min-h-0 flex flex-col bg-background-light dark:bg-background-dark overflow-hidden">
<!-- Bottom Sheet Wrapper -->
<div class="flex flex-col h-full w-full justify-end items-stretch">
<div class="flex flex-col items-stretch bg-white dark:bg-[#111722] rounded-t-xl border-t border-slate-200 dark:border-slate-800 shadow-2xl">
<!-- BottomSheetHandle -->
<button class="flex h-6 w-full items-center justify-center">
<div class="h-1.5 w-12 rounded-full bg-slate-300 dark:bg-[#324467]"></div>
</button>
<!-- Header Section -->
<div class="flex items-center px-6 py-4 border-b border-slate-100 dark:border-slate-800 justify-between">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-slate-400 dark:text-slate-500">policy</span>
<h2 class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-tight">Policy Detail</h2>
</div>
<button class="flex size-10 items-center justify-center rounded-full hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
<span class="material-symbols-outlined text-slate-500 dark:text-slate-400">close</span>
</button>
</div>
<!-- Policy Identity -->
<div class="px-6 pt-6">
<h3 class="text-slate-900 dark:text-white text-2xl font-bold leading-tight mb-4">
                        DR-01: Production Dry Run Enforcement
                    </h3>
<!-- Status Badges -->
<div class="flex gap-3 flex-wrap">
<div class="flex h-8 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 px-3">
<span class="material-symbols-outlined text-emerald-600 dark:text-emerald-400 text-[18px]">check_circle</span>
<p class="text-emerald-700 dark:text-emerald-400 text-xs font-semibold uppercase tracking-wider">Status: Active</p>
</div>
<div class="flex h-8 shrink-0 items-center justify-center gap-x-2 rounded-lg bg-red-50 dark:bg-red-500/10 border border-red-200 dark:border-red-500/20 px-3">
<span class="material-symbols-outlined text-red-600 dark:text-red-400 text-[18px]">error</span>
<p class="text-red-700 dark:text-red-400 text-xs font-semibold uppercase tracking-wider">Violation Detected</p>
</div>
</div>
</div>
<!-- Content Area -->
<div class="px-6 py-6 space-y-8 max-h-[60vh] overflow-y-auto">
<!-- Description -->
<section>
<h4 class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-2">Description</h4>
<p class="text-slate-700 dark:text-slate-300 text-base leading-relaxed">
                            To ensure stability and prevent accidental outages, all runbooks targeting production environments must successfully complete a dry run before full execution. This prevents destructive commands from running without verification.
                        </p>
</section>
<!-- Enforcement Level -->
<section>
<h4 class="text-slate-500 dark:text-slate-400 text-xs font-bold uppercase tracking-widest mb-3">Enforcement Level</h4>
<div class="inline-flex items-center gap-3 bg-primary/10 dark:bg-primary/20 border border-primary/30 rounded-lg p-3 w-full">
<span class="material-symbols-outlined text-primary">lock_clock</span>
<div>
<p class="text-slate-900 dark:text-white font-bold text-sm">Hard Block / Required Step</p>
<p class="text-slate-600 dark:text-slate-400 text-xs">Execution is prevented until all conditions are met.</p>
</div>
</div>
</section>
<!-- Remediation -->
<section class="bg-slate-50 dark:bg-slate-800/40 rounded-xl p-5 border border-slate-100 dark:border-slate-800">
<div class="flex items-center gap-2 mb-4">
<span class="material-symbols-outlined text-primary">auto_fix_high</span>
<h4 class="text-slate-900 dark:text-white text-sm font-bold">How to Fix</h4>
</div>
<div class="space-y-4">
<div class="flex gap-4">
<div class="flex-none flex items-center justify-center size-6 rounded-full bg-primary text-white text-xs font-bold">1</div>
<p class="text-slate-700 dark:text-slate-300 text-sm leading-snug">Click the <span class="font-mono bg-slate-200 dark:bg-slate-700 px-1.5 py-0.5 rounded text-xs font-bold">"Dry Run"</span> button in the header toolbar.</p>
</div>
<div class="flex gap-4">
<div class="flex-none flex items-center justify-center size-6 rounded-full bg-primary text-white text-xs font-bold">2</div>
<p class="text-slate-700 dark:text-slate-300 text-sm leading-snug">Review the predicted side effects in the output console.</p>
</div>
<div class="flex gap-4">
<div class="flex-none flex items-center justify-center size-6 rounded-full bg-primary text-white text-xs font-bold">3</div>
<p class="text-slate-700 dark:text-slate-300 text-sm leading-snug">Proceed to execution once the check passes and the "Execute" button is enabled.</p>
</div>
</div>
</section>
</div>
<!-- Footer Actions -->
<div class="p-6 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row gap-3">
<button class="flex-1 flex items-center justify-center h-12 rounded-lg bg-primary hover:bg-primary/90 text-white font-bold transition-all shadow-lg shadow-primary/20">
                        Close Detail
                    </button>
<button class="flex-1 flex items-center justify-center h-12 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 font-bold transition-all">
                        View Full Org Policies
                    </button>
</div>
<!-- Bottom spacer for safe area -->
<div class="h-4 bg-white dark:bg-[#111722]"></div>
</div>
</div>
</div>
</body></html>6:["$","div",null,{"className":"min-h-screen bg-gray-50","children":[["$","header",null,{"className":"bg-white border-b border-gray-200 py-4 px-6 md:px-8 sticky top-0 z-20","children":["$","div",null,{"className":"max-w-7xl mx-auto flex items-center justify-between","children":[["$","div",null,{"className":"flex items-center gap-4","children":[["$","$L5",null,{"href":"/capabilities","className":"p-2 hover:bg-gray-100 rounded-lg text-gray-500 transition-colors","children":["$","svg",null,{"className":"w-5 h-5","fill":"none","viewBox":"0 0 24 24","stroke":"currentColor","children":["$","path",null,{"strokeLinecap":"round","strokeLinejoin":"round","strokeWidth":2,"d":"M10 19l-7-7m0 0l7-7m-7 7h18"}]}]}],["$","div",null,{"children":[["$","h1",null,{"className":"text-lg font-bold text-gray-900 tracking-tight","children":"View Policy Detail"}],["$","p",null,{"className":"text-xs text-blue-600 font-medium uppercase tracking-widest","children":"CLI & Automation"}]]}]]}],["$","div",null,{"className":"flex gap-3","children":["$","div",null,{"className":"hidden sm:flex items-center gap-2 px-3 py-1 bg-yellow-50 text-yellow-700 rounded-full text-xs font-medium border border-yellow-100","children":[["$","span",null,{"className":"w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse"}],"Live Preview"]}]}]]}]}],["$","main",null,{"className":"w-full","children":["$","div",null,{"className":"bg-white rounded-none shadow-none overflow-hidden","children":["$","iframe",null,{"title":"View Policy Detail","srcDoc":"$f","className":"w-full h-[calc(100vh-65px)] border-none","sandbox":"allow-scripts allow-same-origin"}]}]}]]}]
