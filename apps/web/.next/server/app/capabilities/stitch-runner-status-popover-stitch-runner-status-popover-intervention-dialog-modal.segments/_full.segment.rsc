<div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/50 rounded-lg p-3 mb-5 flex gap-3">
<span class="material-icons-round text-amber-600 dark:text-amber-400 shrink-0 mt-0.5">warning</span>
