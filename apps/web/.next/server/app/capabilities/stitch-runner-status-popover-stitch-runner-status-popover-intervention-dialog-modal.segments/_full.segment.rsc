</div>
<div>
<h2 class="text-lg font-semibold text-slate-900 dark:text-white leading-tight">Action Required</h2>
<p class="text-xs text-slate-500 dark:text-slate-400">Runner ID: <span class="font-mono">run-ax92-f4</span></p>
</div>
</div>
<button class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors">
