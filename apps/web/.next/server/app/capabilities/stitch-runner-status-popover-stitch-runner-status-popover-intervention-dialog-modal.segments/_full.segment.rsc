<div class="bg-slate-50 dark:bg-slate-800/50 rounded-md p-3 border border-border-light dark:border-border-dark">
<code class="text-xs text-red-600 dark:text-red-400 font-mono break-all">Error: Invalid property 'timestamp_ms' expected number, got string.</code>
</div>
</div>
<div>
<div class="flex items-center justify-between mb-2">
<label class="block text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wide">Input Overrides</label>
<button class="text-xs text-primary hover:text-blue-600 font-medium flex items-center gap-1">
<span class="material-icons-round text-[14px]">history</span>
                        Restore Default
                    </button>
</div>
<div class="relative group">
<div class="absolute right-2 top-2 opacity-0 group-hover:opacity-100 transition-opacity">
<button class="p-1 rounded bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-600 dark:text-slate-300" title="Format JSON">
<span class="material-icons-round text-sm">code</span>
</button>
</div>
<textarea class="w-full h-48 bg-slate-900 text-slate-300 font-mono text-xs p-3 rounded-lg border border-slate-700 focus:border-primary focus:ring-1 focus:ring-primary outline-none resize-none leading-relaxed json-scroll" spellcheck="false">{
  "task_id": "gen_8821",
  "priority": "high",
  "payload": {
    "timestamp_ms": 1699402100,
    "retry_strategy": "exponential",
    "context": {
        "region": "us-east-1",
        "shards": 4
    }
  }
}</textarea>
<div class="mt-1 flex justify-end">
<span class="text-[10px] text-green-600 dark:text-green-400 flex items-center gap-1">
<span class="material-icons-round text-[10px]">check_circle</span> Valid JSON
                        </span>
</div>
</div>
</div>
</div>
<div class="p-5 border-t border-border-light dark:border-border-dark bg-slate-50 dark:bg-slate-800/30 shrink-0 flex flex-col gap-3">
<button class="w-full bg-primary hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg shadow-sm active:transform active:scale-[0.98] transition-all flex items-center justify-center gap-2">
<span class="material-icons-round text-sm">edit_note</span>
                Retry with Overrides
            </button>
<div class="grid grid-cols-2 gap-3">
<button class="w-full bg-white dark:bg-slate-700 border border-border-light dark:border-slate-600 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-600 font-medium py-2.5 px-4 rounded-lg shadow-sm active:transform active:scale-[0.98] transition-all flex items-center justify-center gap-2 text-sm">
<span class="material-icons-round text-sm">replay</span>
                    Retry Same
                </button>
<button class="w-full bg-transparent border border-transparent text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 font-medium py-2.5 px-4 rounded-lg active:transform active:scale-[0.98] transition-all text-sm">
                    Acknowledge
                </button>
</div>
</div>
</div>
<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none opacity-20 dark:opacity-10">
<div class="absolute -top-[50%] -left-[50%] w-[200%] h-[200%] bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-indigo-200 via-slate-100 to-transparent dark:from-indigo-900 dark:via-slate-900"></div>
</div>

