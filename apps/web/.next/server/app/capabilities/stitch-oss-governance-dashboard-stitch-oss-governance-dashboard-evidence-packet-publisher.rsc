f:T3cc6,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Evidence Packet Publisher</title>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                "primary": "#137fec",
                "background-light": "#f6f7f8",
                "background-dark": "#101922",
                "surface-dark": "#1e242b",
                "surface-light": "#ffffff",
              },
              fontFamily: {
                "display": ["Inter", "sans-serif"],
                "mono": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"],
              },
              borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "full": "9999px"},
            },
          },
        }
      </script>
<style>
        /* Custom scrollbar hiding for clean UI */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-white antialiased overflow-x-hidden">
<div class="relative flex min-h-screen w-full flex-col mx-auto max-w-md bg-background-light dark:bg-background-dark shadow-xl overflow-hidden">
<!-- Top App Bar -->
<div class="sticky top-0 z-50 flex items-center bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md p-4 pb-2 justify-between border-b border-gray-200 dark:border-gray-800">
<button class="text-slate-900 dark:text-white flex size-10 shrink-0 items-center justify-center rounded-full hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors">
<span class="material-symbols-outlined" style="font-size: 24px;">arrow_back</span>
</button>
<h2 class="text-slate-900 dark:text-white text-lg font-bold leading-tight tracking-[-0.015em] flex-1 text-center">Review Packet</h2>
<button class="flex h-10 px-2 items-center justify-end">
<p class="text-gray-500 dark:text-[#9dabb9] text-sm font-medium leading-normal tracking-[0.015em] shrink-0">Cancel</p>
</button>
</div>
<!-- Main Content -->
<div class="flex-1 flex flex-col p-4 gap-6 pb-24 overflow-y-auto no-scrollbar">
<!-- Packet Identity Card -->
<div class="relative overflow-hidden rounded-2xl bg-surface-light dark:bg-surface-dark shadow-sm border border-gray-200 dark:border-gray-800">
<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-primary to-purple-500"></div>
<div class="p-5 flex flex-col gap-4">
<div class="flex items-center justify-between">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-green-500" style="font-size: 20px;">verified_user</span>
<p class="text-xs font-bold text-green-600 dark:text-green-400 uppercase tracking-wider">Ready for Publication</p>
</div>
<span class="text-xs text-gray-500 dark:text-gray-400">v1.4.2</span>
</div>
<div class="flex flex-col gap-1">
<p class="text-gray-500 dark:text-gray-400 text-xs font-medium uppercase tracking-wider">Cryptographic Fingerprint</p>
<div class="flex items-center gap-3 group cursor-pointer active:scale-95 transition-transform">
<p class="font-mono text-2xl font-bold tracking-tight text-slate-900 dark:text-white break-all leading-none">
                                8f43...9a12
                            </p>
<button class="text-primary hover:text-blue-400 transition-colors">
<span class="material-symbols-outlined" style="font-size: 20px;">content_copy</span>
</button>
</div>
</div>
<div class="h-px w-full bg-gray-100 dark:bg-gray-700"></div>
<div class="flex justify-between items-center text-xs text-gray-500 dark:text-gray-400">
<span>Generated: Today, 14:02 PM</span>
<span>Size: 24KB</span>
</div>
</div>
<!-- Abstract visual pattern for identity -->
<div class="h-2 w-full bg-gradient-to-r from-primary/20 via-primary/5 to-transparent absolute bottom-0"></div>
</div>
<!-- Packet Contents Accordions -->
<div class="flex flex-col gap-4">
<h3 class="text-slate-900 dark:text-white text-lg font-bold px-1">Packet Contents</h3>
<div class="flex flex-col gap-3">
<!-- Core Claims -->
<details class="flex flex-col rounded-xl border border-gray-200 dark:border-gray-700 bg-surface-light dark:bg-surface-dark group overflow-hidden" open="">
<summary class="flex cursor-pointer items-center justify-between p-4 bg-gray-50 dark:bg-surface-dark/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors select-none">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-primary">
<span class="material-symbols-outlined" style="font-size: 18px;">gavel</span>
</div>
<div>
<p class="text-slate-900 dark:text-white text-sm font-semibold leading-normal">Core Claims</p>
<p class="text-xs text-gray-500 dark:text-gray-400">3 Verified</p>
</div>
</div>
<span class="material-symbols-outlined text-gray-400 group-open:rotate-180 transition-transform duration-200">expand_more</span>
</summary>
<div class="px-4 py-3 flex flex-col gap-3 border-t border-gray-100 dark:border-gray-800">
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-green-500" style="font-size: 16px;">check_circle</span>
<span class="text-sm text-slate-700 dark:text-gray-300">SOC2 Compliance Met</span>
</div>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-green-500" style="font-size: 16px;">check_circle</span>
<span class="text-sm text-slate-700 dark:text-gray-300">Encryption Standard AES-256</span>
</div>
<div class="flex items-center gap-3">
<span class="material-symbols-outlined text-green-500" style="font-size: 16px;">check_circle</span>
<span class="text-sm text-slate-700 dark:text-gray-300">Data Retention Policy Active</span>
</div>
</div>
</details>
<!-- Supporting Evidence -->
<details class="flex flex-col rounded-xl border border-gray-200 dark:border-gray-700 bg-surface-light dark:bg-surface-dark group overflow-hidden">
<summary class="flex cursor-pointer items-center justify-between p-4 bg-gray-50 dark:bg-surface-dark/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors select-none">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-purple-100 dark:bg-purple-900/30 flex items-center justify-center text-purple-600 dark:text-purple-400">
<span class="material-symbols-outlined" style="font-size: 18px;">folder_open</span>
</div>
<div>
<p class="text-slate-900 dark:text-white text-sm font-semibold leading-normal">Supporting Evidence</p>
<p class="text-xs text-gray-500 dark:text-gray-400">5 Artifacts Linked</p>
</div>
</div>
<span class="material-symbols-outlined text-gray-400 group-open:rotate-180 transition-transform duration-200">expand_more</span>
</summary>
<div class="px-4 py-3 flex flex-col gap-3 border-t border-gray-100 dark:border-gray-800">
<div class="flex items-center justify-between py-1">
<div class="flex items-center gap-2 overflow-hidden">
<span class="material-symbols-outlined text-gray-400" style="font-size: 16px;">description</span>
<span class="text-sm text-slate-700 dark:text-gray-300 truncate font-mono text-xs">system_logs_v4.txt</span>
</div>
<span class="text-[10px] bg-gray-100 dark:bg-gray-700 text-gray-500 px-1.5 py-0.5 rounded">2MB</span>
</div>
<div class="flex items-center justify-between py-1">
<div class="flex items-center gap-2 overflow-hidden">
<span class="material-symbols-outlined text-gray-400" style="font-size: 16px;">picture_as_pdf</span>
<span class="text-sm text-slate-700 dark:text-gray-300 truncate font-mono text-xs">Audit_Report_2023.pdf</span>
</div>
<span class="text-[10px] bg-gray-100 dark:bg-gray-700 text-gray-500 px-1.5 py-0.5 rounded">8.5MB</span>
</div>
</div>
</details>
<!-- Explicit Assumptions -->
<details class="flex flex-col rounded-xl border border-gray-200 dark:border-gray-700 bg-surface-light dark:bg-surface-dark group overflow-hidden">
<summary class="flex cursor-pointer items-center justify-between p-4 bg-gray-50 dark:bg-surface-dark/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors select-none">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center text-amber-600 dark:text-amber-400">
<span class="material-symbols-outlined" style="font-size: 18px;">lightbulb</span>
</div>
<div>
<p class="text-slate-900 dark:text-white text-sm font-semibold leading-normal">Explicit Assumptions</p>
<p class="text-xs text-gray-500 dark:text-gray-400">2 Listed</p>
</div>
</div>
<span class="material-symbols-outlined text-gray-400 group-open:rotate-180 transition-transform duration-200">expand_more</span>
</summary>
<div class="px-4 py-3 flex flex-col gap-3 border-t border-gray-100 dark:border-gray-800">
<p class="text-sm text-slate-600 dark:text-gray-300 border-l-2 border-amber-500 pl-3 italic">
                                "AWS us-east-1 availability remains &gt; 99.9%"
                            </p>
<p class="text-sm text-slate-600 dark:text-gray-300 border-l-2 border-amber-500 pl-3 italic">
                                "Validator node count stable at 15"
                            </p>
</div>
</details>
<!-- Uncertainty Ledger -->
<details class="flex flex-col rounded-xl border border-gray-200 dark:border-gray-700 bg-surface-light dark:bg-surface-dark group overflow-hidden">
<summary class="flex cursor-pointer items-center justify-between p-4 bg-gray-50 dark:bg-surface-dark/50 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors select-none">
<div class="flex items-center gap-3">
<div class="size-8 rounded-full bg-teal-100 dark:bg-teal-900/30 flex items-center justify-center text-teal-600 dark:text-teal-400">
<span class="material-symbols-outlined" style="font-size: 18px;">analytics</span>
</div>
<div>
<p class="text-slate-900 dark:text-white text-sm font-semibold leading-normal">Uncertainty Ledger</p>
<p class="text-xs text-green-600 dark:text-green-400 font-medium">Low Risk</p>
</div>
</div>
<span class="material-symbols-outlined text-gray-400 group-open:rotate-180 transition-transform duration-200">expand_more</span>
</summary>
<div class="px-4 py-4 border-t border-gray-100 dark:border-gray-800">
<div class="flex flex-col items-center justify-center py-2 gap-2 text-center">
<span class="material-symbols-outlined text-green-500 text-3xl">check_circle_outline</span>
<p class="text-sm text-slate-900 dark:text-white font-medium">No critical uncertainties logged</p>
<p class="text-xs text-gray-500 dark:text-gray-400">All risk factors are within acceptable tolerance.</p>
</div>
</div>
</details>
</div>
</div>
<!-- Export Options -->
<div class="flex flex-col gap-4">
<h3 class="text-slate-900 dark:text-white text-lg font-bold px-1">Export Format</h3>
<div class="grid grid-cols-3 gap-3">
<!-- PDF Option -->
<label class="cursor-pointer group relative">
<input checked="" class="peer sr-only" name="export_format" type="radio"/>
<div class="flex flex-col items-center gap-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-surface-light dark:bg-surface-dark p-3 transition-all peer-checked:border-primary peer-checked:bg-primary/5 dark:peer-checked:bg-primary/10 peer-checked:shadow-sm">
<span class="material-symbols-outlined text-gray-400 peer-checked:text-primary transition-colors group-hover:text-primary">picture_as_pdf</span>
<span class="text-xs font-medium text-slate-700 dark:text-gray-300 peer-checked:text-primary">PDF Doc</span>
</div>
<div class="absolute -top-1 -right-1 hidden size-4 items-center justify-center rounded-full bg-primary text-white peer-checked:flex">
<span class="material-symbols-outlined text-[10px]">check</span>
</div>
</label>
<!-- JSON Option -->
<label class="cursor-pointer group relative">
<input class="peer sr-only" name="export_format" type="radio"/>
<div class="flex flex-col items-center gap-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-surface-light dark:bg-surface-dark p-3 transition-all peer-checked:border-primary peer-checked:bg-primary/5 dark:peer-checked:bg-primary/10 peer-checked:shadow-sm">
<span class="material-symbols-outlined text-gray-400 peer-checked:text-primary transition-colors group-hover:text-primary">data_object</span>
<span class="text-xs font-medium text-slate-700 dark:text-gray-300 peer-checked:text-primary">JSON Manifest</span>
</div>
<div class="absolute -top-1 -right-1 hidden size-4 items-center justify-center rounded-full bg-primary text-white peer-checked:flex">
<span class="material-symbols-outlined text-[10px]">check</span>
</div>
</label>
<!-- Hash Option -->
<label class="cursor-pointer group relative">
<input class="peer sr-only" name="export_format" type="radio"/>
<div class="flex flex-col items-center gap-2 rounded-xl border border-gray-200 dark:border-gray-700 bg-surface-light dark:bg-surface-dark p-3 transition-all peer-checked:border-primary peer-checked:bg-primary/5 dark:peer-checked:bg-primary/10 peer-checked:shadow-sm">
<span class="material-symbols-outlined text-gray-400 peer-checked:text-primary transition-colors group-hover:text-primary">tag</span>
<span class="text-xs font-medium text-slate-700 dark:text-gray-300 peer-checked:text-primary">Hash Anchor</span>
</div>
<div class="absolute -top-1 -right-1 hidden size-4 items-center justify-center rounded-full bg-primary text-white peer-checked:flex">
<span class="material-symbols-outlined text-[10px]">check</span>
</div>
</label>
</div>
</div>
<!-- Disclaimer -->
<div class="rounded-lg bg-blue-50 dark:bg-blue-900/10 border border-blue-100 dark:border-blue-900/30 p-3 flex gap-3">
<span class="material-symbols-outlined text-blue-600 dark:text-blue-400 shrink-0" style="font-size: 20px;">info</span>
<p class="text-xs text-blue-800 dark:text-blue-200 leading-relaxed">
                    By publishing, you certify that all claims are verified. This action is immutable and will be recorded on the public ledger.
                </p>
</div>
</div>
<!-- Sticky Bottom Action -->
<div class="sticky bottom-0 z-50 w-full bg-background-light dark:bg-background-dark p-4 border-t border-gray-200 dark:border-gray-800 backdrop-blur-xl bg-opacity-95 dark:bg-opacity-95 safe-pb">
<button class="flex w-full cursor-pointer items-center justify-center gap-3 rounded-lg bg-primary p-4 text-white hover:bg-blue-600 transition-all active:scale-[0.98] shadow-lg shadow-blue-900/20 group">
<span class="text-base font-bold tracking-tight">Sign &amp; Publish Packet</span>
<span class="material-symbols-outlined group-hover:translate-x-1 transition-transform" style="font-size: 20px;">send</span>
</button>
</div>
</div>
