<div class="bg-white dark:bg-surface-dark rounded-xl border border-primary/20 shadow-sm overflow-hidden relative">
<div class="absolute top-0 left-0 w-1 h-full bg-primary"></div>
<div class="p-4">
<div class="flex justify-between items-start mb-3">
<div class="flex flex-col">
<div class="flex items-center gap-2 mb-1">
<span class="text-xs font-mono text-primary bg-primary/10 px-1.5 py-0.5 rounded">#402-ALPHA</span>
<div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-primary/10 border border-primary/20">
<span class="w-1.5 h-1.5 rounded-full bg-primary pulse-dot"></span>
<span class="text-[10px] font-bold uppercase tracking-wider text-primary">Running</span>
</div>
</div>
<h3 class="text-base font-bold text-gray-900 dark:text-white">Compliance Scan: v2.4 Modules</h3>
</div>
<button class="text-gray-400 hover:text-white">
<span class="material-symbols-outlined">more_horiz</span>
</button>
</div>
<!-- Metrics Grid -->
<div class="grid grid-cols-3 gap-2 mb-4">
<div class="flex flex-col gap-1 p-2 rounded bg-gray-50 dark:bg-[#111418]">
<span class="text-[10px] uppercase text-gray-500 font-semibold tracking-wider">CPU</span>
<div class="flex items-end justify-between">
<span class="text-sm font-mono font-bold text-gray-900 dark:text-gray-200">82%</span>
<div class="w-8 h-1 bg-gray-700 rounded-full overflow-hidden">
<div class="h-full bg-orange-500 w-[82%]"></div>
</div>
</div>
</div>
<div class="flex flex-col gap-1 p-2 rounded bg-gray-50 dark:bg-[#111418]">
<span class="text-[10px] uppercase text-gray-500 font-semibold tracking-wider">RAM</span>
<div class="flex items-end justify-between">
<span class="text-sm font-mono font-bold text-gray-900 dark:text-gray-200">4.2<span class="text-[10px] text-gray-500">G</span></span>
<div class="w-8 h-1 bg-gray-700 rounded-full overflow-hidden">
<div class="h-full bg-primary w-[40%]"></div>
</div>
</div>
</div>
<div class="flex flex-col gap-1 p-2 rounded bg-gray-50 dark:bg-[#111418]">
<span class="text-[10px] uppercase text-gray-500 font-semibold tracking-wider">Tokens</span>
<div class="flex items-end justify-between">
<span class="text-sm font-mono font-bold text-gray-900 dark:text-gray-200">12<span class="text-[10px] text-gray-500">k</span></span>
<div class="w-8 h-1 bg-gray-700 rounded-full overflow-hidden">
<div class="h-full bg-green-500 w-[20%]"></div>
</div>
</div>
</div>
</div>
<!-- Progress Bar -->
<div class="flex flex-col gap-1.5 mb-4">
<div class="flex justify-between text-xs text-gray-500 dark:text-gray-400">
<span>Processing Module 4/12</span>
<span>Est: 45m</span>
</div>
<div class="h-1.5 w-full bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
