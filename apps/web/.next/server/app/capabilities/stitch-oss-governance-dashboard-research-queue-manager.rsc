f:T3a0f,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Research Queue Manager</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#137fec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101922",
                        "surface-dark": "#161e27",
                        "surface-light": "#ffffff",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"],
                        "mono": ["JetBrains Mono", "monospace"],
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
        .pulse-dot {
            animation: pulse-animation 2s infinite;
        }
        @keyframes pulse-animation {
            0% { box-shadow: 0 0 0 0 rgba(19, 127, 236, 0.7); }
            70% { box-shadow: 0 0 0 6px rgba(19, 127, 236, 0); }
            100% { box-shadow: 0 0 0 0 rgba(19, 127, 236, 0); }
        }
        /* Custom scrollbar for horizontal scrolling */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display antialiased min-h-screen flex flex-col">
<!-- Header -->
<header class="sticky top-0 z-20 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
<div class="flex items-center justify-between px-4 py-3">
<div class="flex items-center gap-3">
<button class="flex items-center justify-center p-1 rounded-full text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors">
<span class="material-symbols-outlined">arrow_back</span>
</button>
<div>
<h1 class="text-lg font-bold text-gray-900 dark:text-white leading-tight">Research Queue</h1>
<p class="text-xs text-primary font-medium">GovConsole v4.2</p>
</div>
</div>
<button class="p-2 rounded-full bg-gray-100 dark:bg-surface-dark text-gray-600 dark:text-gray-300">
<span class="material-symbols-outlined text-[20px]">terminal</span>
</button>
</div>
<!-- Global Stats Marquee/Grid -->
<div class="px-4 pb-3 overflow-x-auto hide-scrollbar">
<div class="flex gap-3 min-w-max">
<!-- Stat 1 -->
<div class="bg-white dark:bg-surface-dark p-3 rounded-lg border border-gray-100 dark:border-gray-800 w-[140px] flex flex-col justify-between">
<div class="flex items-center justify-between mb-1">
<span class="text-xs text-gray-500 dark:text-gray-400 font-medium">CPU Load</span>
<span class="material-symbols-outlined text-green-500 text-[16px]">trending_up</span>
</div>
<div class="flex items-end gap-2">
<span class="text-xl font-bold text-gray-900 dark:text-white font-mono">42%</span>
<span class="text-xs text-green-500 font-medium mb-1">+2.1%</span>
</div>
</div>
<!-- Stat 2 -->
<div class="bg-white dark:bg-surface-dark p-3 rounded-lg border border-gray-100 dark:border-gray-800 w-[140px] flex flex-col justify-between">
<div class="flex items-center justify-between mb-1">
<span class="text-xs text-gray-500 dark:text-gray-400 font-medium">Memory</span>
</div>
<div class="flex items-end gap-2">
<span class="text-xl font-bold text-gray-900 dark:text-white font-mono">8.4<span class="text-sm text-gray-500">GB</span></span>
</div>
</div>
<!-- Stat 3 -->
<div class="bg-white dark:bg-surface-dark p-3 rounded-lg border border-gray-100 dark:border-gray-800 w-[140px] flex flex-col justify-between">
<div class="flex items-center justify-between mb-1">
<span class="text-xs text-gray-500 dark:text-gray-400 font-medium">Tokens</span>
</div>
<div class="flex items-end gap-2">
<span class="text-xl font-bold text-gray-900 dark:text-white font-mono">1.2<span class="text-sm text-gray-500">M</span></span>
<span class="text-xs text-green-500 font-medium mb-1">↑</span>
</div>
</div>
</div>
</div>
<!-- Segmented Control -->
<div class="px-4 pb-3">
<div class="flex p-1 bg-gray-200 dark:bg-surface-dark rounded-lg">
<button class="flex-1 py-1.5 px-3 rounded-md bg-white dark:bg-[#2A3441] shadow-sm text-sm font-semibold text-primary text-center transition-all">
                    Active Loops (3)
                </button>
<button class="flex-1 py-1.5 px-3 rounded-md text-sm font-medium text-gray-500 dark:text-gray-400 text-center hover:text-gray-900 dark:hover:text-white transition-all">
                    History
                </button>
</div>
</div>
</header>
<!-- Main Content -->
<main class="flex-1 px-4 py-2 flex flex-col gap-4 pb-24">
