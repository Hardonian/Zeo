</div>
</div>
<!-- Actions -->
<div class="flex gap-2">
<button class="flex-1 flex items-center justify-center gap-2 h-9 rounded bg-primary/10 hover:bg-primary/20 text-primary text-sm font-semibold transition-colors">
<span class="material-symbols-outlined text-[18px]">pause</span>
                        Pause
                    </button>
<button class="w-9 h-9 flex items-center justify-center rounded bg-gray-100 dark:bg-gray-800 text-red-500 hover:text-red-400 transition-colors">
<span class="material-symbols-outlined text-[18px]">stop</span>
</button>
</div>
</div>
</div>
<!-- Active Loop Card: Paused -->
<div class="bg-white dark:bg-surface-dark rounded-xl border border-gray-200 dark:border-gray-800 shadow-sm overflow-hidden relative opacity-90">
<div class="p-4">
<div class="flex justify-between items-start mb-3">
<div class="flex flex-col">
