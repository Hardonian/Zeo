<span class="material-symbols-outlined text-[14px]">code</span>
</div>
<span class="text-xs font-semibold uppercase tracking-wide text-white/90">ReadyLayer</span>
<span class="text-xs text-white/60">• 1m ago</span>
</div>
</div>
<!-- Content -->
<div class="flex gap-3">
<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-red-500/20 text-red-400">
<span class="material-symbols-outlined">shield</span>
</div>
<div class="flex-1">
<h3 class="text-base font-bold leading-tight text-white mb-0.5">Review Guard</h3>
<p class="text-sm leading-snug text-white/90">High-risk path detected in recent commit to <span class="font-mono text-xs bg-white/10 px-1 rounded">main</span>.</p>
</div>
</div>
</div>
<!-- Action Footer (Simulating iOS Expanded Action or Bottom Buttons) -->
<div class="flex border-t border-white/10 bg-white/5">
<button class="flex-1 py-3 text-sm font-semibold text-primary active:bg-white/10 transition-colors">
                        View PR
                    </button>
</div>
</div>
<!-- Notification 2: Doc Sync (Warning) -->
<div class="group relative w-full overflow-hidden rounded-2xl glass-panel transition-all active:scale-[0.98]">
<div class="p-4">
<!-- Header -->
<div class="mb-2 flex items-center justify-between">
<div class="flex items-center gap-2">
<div class="flex h-5 w-5 items-center justify-center rounded bg-[#135bec] text-white">
<span class="material-symbols-outlined text-[14px]">code</span>
</div>
<span class="text-xs font-semibold uppercase tracking-wide text-white/90">ReadyLayer</span>
<span class="text-xs text-white/60">• 15m ago</span>
</div>
</div>
<!-- Content -->
<div class="flex gap-3">
<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-500/20 text-amber-400">
<span class="material-symbols-outlined">description</span>
</div>
<div class="flex-1">
<h3 class="text-base font-bold leading-tight text-white mb-0.5">Doc Sync</h3>
<p class="text-sm leading-snug text-white/90">Documentation drift detected in <span class="font-mono text-xs bg-white/10 px-1 rounded">auth-service</span>. API schema mismatch.</p>
</div>
</div>
</div>
<!-- Action Footer -->
<div class="flex border-t border-white/10 bg-white/5">
<button class="flex-1 py-3 text-sm font-semibold text-primary active:bg-white/10 transition-colors">
                        Diff View
                    </button>
</div>
</div>
<!-- Notification 3: Test Engine (Success) -->
<div class="group relative w-full overflow-hidden rounded-2xl glass-panel transition-all active:scale-[0.98]">
<div class="p-4">
<!-- Header -->
<div class="mb-2 flex items-center justify-between">
<div class="flex items-center gap-2">
<div class="flex h-5 w-5 items-center justify-center rounded bg-[#135bec] text-white">
<span class="material-symbols-outlined text-[14px]">code</span>
</div>
<span class="text-xs font-semibold uppercase tracking-wide text-white/90">ReadyLayer</span>
<span class="text-xs text-white/60">• 1h ago</span>
</div>
</div>
<!-- Content -->
<div class="flex gap-3">
<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-green-500/20 text-green-400">
<span class="material-symbols-outlined">check_circle</span>
</div>
<div class="flex-1">
<h3 class="text-base font-bold leading-tight text-white mb-0.5">Test Engine</h3>
<p class="text-sm leading-snug text-white/90">Staging workflow verification complete: All systems ready.</p>
</div>
</div>
</div>
<!-- Action Footer -->
<div class="flex border-t border-white/10 bg-white/5 divide-x divide-white/10">
<button class="flex-1 py-3 text-sm font-medium text-white/70 active:bg-white/10 transition-colors">
                        Dismiss
                    </button>
<button class="flex-1 py-3 text-sm font-semibold text-primary active:bg-white/10 transition-colors">
                        See Details
                    </button>
</div>
</div>
</div>
<!-- Bottom Actions (Flashlight / Camera) -->
<div class="relative z-10 flex w-full items-center justify-between px-12 pb-10 pt-4">
<button class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 backdrop-blur-lg hover:bg-white/20 transition-colors">
<span class="material-symbols-outlined text-white">flashlight_on</span>
</button>
<!-- Home Indicator -->
<div class="h-1 w-32 rounded-full bg-white mb-2 self-end"></div>
<button class="flex h-12 w-12 items-center justify-center rounded-full bg-white/10 backdrop-blur-lg hover:bg-white/20 transition-colors">
<span class="material-symbols-outlined text-white">photo_camera</span>
</button>
</div>
</div>
