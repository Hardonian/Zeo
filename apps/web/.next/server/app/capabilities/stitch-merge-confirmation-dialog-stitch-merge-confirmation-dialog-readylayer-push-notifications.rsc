<body class="bg-background-light dark:bg-black font-display text-white overflow-hidden">
<!-- Mobile Container -->
<div class="relative mx-auto h-screen w-full max-w-md overflow-hidden bg-black shadow-2xl sm:rounded-[3rem] sm:border-[8px] sm:border-gray-800 sm:h-[850px] sm:my-8 ios-gradient-bg flex flex-col justify-between" data-alt="Abstract dark geometric technical wallpaper with subtle blue gradients" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuB0etSChf3JvNH31XIglvzmdH91zKh6ZrYhJOt-Bsl2fFXya6t-SXHrW1OFtXj_WlhXCbVotuwtig36J881qMNjZFzXgJihxGnvKXrHgFLpAuDNSeOlraCBssxJZDHIjRXvUw1hS6Pv8KKrk9cLW-a2schLjV4tfIFf3Xb_MWk-KDn8t4Kk_w_jglioOVfy0L9JvzUjVwsWXGQH_7CbH9uPuGTK6F1RsW0Yxmf_KcMcaV4SjkT8fNYccTr0G7f9INAqAdLLZy3PtASp'); background-size: cover; background-position: center;">
<!-- Overlay for readability -->
<div class="absolute inset-0 bg-black/40 backdrop-blur-[2px]"></div>
<!-- Top Status Bar & Clock Area -->
<div class="relative z-10 flex flex-col items-center pt-14 px-6 w-full">
