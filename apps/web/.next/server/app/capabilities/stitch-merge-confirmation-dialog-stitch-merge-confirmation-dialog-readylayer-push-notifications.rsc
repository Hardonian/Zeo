<div class="mb-1 flex items-center gap-2 text-lg font-medium text-white/90 drop-shadow-md">
<span class="material-symbols-outlined text-[20px]">lock</span>
<span>Wednesday, September 12</span>
</div>
<!-- Clock -->
<h1 class="text-[86px] font-light leading-none tracking-tight text-white/95 drop-shadow-lg font-display">
                09:41
            </h1>
<!-- Widgets (Optional for realism) -->
<div class="mt-4 flex gap-4 text-white/80">
<div class="flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 backdrop-blur-md border border-white/10">
<span class="material-symbols-outlined text-[16px]">cloud</span>
<span class="text-xs font-medium">68°</span>
</div>
<div class="flex items-center gap-1.5 rounded-full bg-white/10 px-3 py-1 backdrop-blur-md border border-white/10">
<span class="material-symbols-outlined text-[16px]">fitness_center</span>
<span class="text-xs font-medium">350 CAL</span>
</div>
</div>
</div>
<!-- Notifications Stack -->
<div class="relative z-10 flex flex-col gap-3 px-3 pb-8 w-full overflow-y-auto no-scrollbar mask-image-b">
<!-- Notification 1: Review Guard (Urgent) -->
<div class="group relative w-full overflow-hidden rounded-2xl glass-panel transition-all active:scale-[0.98]">
<div class="p-4">
