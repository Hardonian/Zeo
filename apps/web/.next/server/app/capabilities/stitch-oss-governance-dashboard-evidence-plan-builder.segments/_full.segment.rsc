f:T34ea,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Evidence Plan Builder</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#137fec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101922",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
        /* Custom scrollbar for webkit */
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: #3b4754;
            border-radius: 4px;
        }
        /* Hide scrollbar for clean mobile look but keep functionality */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-white overflow-hidden h-screen flex flex-col">
<!-- Top Navigation Bar -->
<header class="flex items-center justify-between px-4 py-3 bg-white dark:bg-[#111418] border-b border-slate-200 dark:border-[#222831] shrink-0 z-20">
<div class="flex items-center gap-3">
<button class="text-slate-500 dark:text-[#9dabb9]">
<span class="material-symbols-outlined">arrow_back</span>
</button>
<h1 class="text-lg font-bold leading-tight">Project Alpha</h1>
</div>
<div class="flex items-center gap-2">
<button class="flex items-center justify-center w-8 h-8 rounded-full hover:bg-slate-100 dark:hover:bg-[#222831]">
<span class="material-symbols-outlined text-slate-500 dark:text-[#9dabb9]" style="font-size: 20px;">history</span>
</button>
<button class="bg-primary hover:bg-blue-600 text-white text-sm font-semibold px-4 py-1.5 rounded-full transition-colors">
                Save
            </button>
</div>
</header>
<!-- Main Content: Scrollable Timeline Canvas -->
<main class="flex-1 overflow-y-auto relative p-4 pb-32 no-scrollbar bg-slate-50 dark:bg-[#111418]">
<div class="flex flex-col gap-6 max-w-md mx-auto">
<!-- Context Header -->
<div class="flex flex-col gap-2 pt-2">
<h2 class="text-2xl font-bold tracking-tight">Strategy Builder</h2>
<p class="text-slate-500 dark:text-[#9dabb9] text-sm leading-relaxed">
                    Build your evidence sequence. Optimize for speed vs. certainty.
                </p>
</div>
<!-- Timeline -->
<div class="relative flex flex-col gap-0 pl-4">
<!-- Vertical connector line background -->
<div class="absolute left-[27px] top-4 bottom-4 w-0.5 bg-slate-200 dark:bg-[#3b4754] -z-10"></div>
<!-- Step 1 -->
<div class="group relative flex gap-4 pb-8">
<div class="flex flex-col items-center">
<div class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-white ring-4 ring-slate-50 dark:ring-[#111418] z-10">
<span class="text-xs font-bold">1</span>
</div>
</div>
<div class="flex-1 bg-white dark:bg-[#1c2127] rounded-lg border border-slate-200 dark:border-[#3b4754] p-4 shadow-sm relative active:scale-[0.98] transition-transform cursor-grab">
<div class="absolute right-2 top-2 text-slate-300 dark:text-[#3b4754]">
<span class="material-symbols-outlined" style="font-size: 20px;">drag_indicator</span>
</div>
<div class="flex gap-3 mb-3">
<div class="p-2 bg-blue-50 dark:bg-blue-900/20 rounded-lg text-primary">
<span class="material-symbols-outlined">menu_book</span>
</div>
<div>
<h3 class="font-semibold text-base">Literature Review</h3>
<p class="text-xs text-slate-500 dark:text-[#9dabb9]">Foundational Research</p>
</div>
</div>
<div class="flex items-center gap-4 border-t border-slate-100 dark:border-[#2c333e] pt-3 mt-1">
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-slate-400 text-[16px]">payments</span>
<span class="text-xs font-medium dark:text-slate-200">$2k</span>
</div>
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-slate-400 text-[16px]">schedule</span>
<span class="text-xs font-medium dark:text-slate-200">1 wk</span>
</div>
<div class="ml-auto text-xs text-green-500 font-medium bg-green-500/10 px-2 py-0.5 rounded">
                                -15% Risk
                            </div>
</div>
</div>
</div>
<!-- Step 2 -->
<div class="group relative flex gap-4 pb-8">
<div class="flex flex-col items-center">
<div class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-white ring-4 ring-slate-50 dark:ring-[#111418] z-10">
<span class="text-xs font-bold">2</span>
</div>
</div>
<div class="flex-1 bg-white dark:bg-[#1c2127] rounded-lg border border-slate-200 dark:border-[#3b4754] p-4 shadow-sm relative active:scale-[0.98] transition-transform cursor-grab">
<div class="absolute right-2 top-2 text-slate-300 dark:text-[#3b4754]">
<span class="material-symbols-outlined" style="font-size: 20px;">drag_indicator</span>
</div>
<div class="flex gap-3 mb-3">
<div class="p-2 bg-purple-50 dark:bg-purple-900/20 rounded-lg text-purple-600 dark:text-purple-400">
<span class="material-symbols-outlined">group</span>
</div>
<div>
<h3 class="font-semibold text-base">Expert Interviews</h3>
<p class="text-xs text-slate-500 dark:text-[#9dabb9]">Qualitative Validation</p>
</div>
</div>
<div class="flex items-center gap-4 border-t border-slate-100 dark:border-[#2c333e] pt-3 mt-1">
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-slate-400 text-[16px]">payments</span>
<span class="text-xs font-medium dark:text-slate-200">$5k</span>
</div>
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-slate-400 text-[16px]">schedule</span>
<span class="text-xs font-medium dark:text-slate-200">2 wks</span>
</div>
<div class="ml-auto text-xs text-green-500 font-medium bg-green-500/10 px-2 py-0.5 rounded">
                                -25% Risk
                            </div>
</div>
</div>
</div>
<!-- Step 3 -->
<div class="group relative flex gap-4 pb-8">
<div class="flex flex-col items-center">
<div class="flex h-6 w-6 items-center justify-center rounded-full bg-primary text-white ring-4 ring-slate-50 dark:ring-[#111418] z-10">
<span class="text-xs font-bold">3</span>
</div>
</div>
<div class="flex-1 bg-white dark:bg-[#1c2127] rounded-lg border border-slate-200 dark:border-[#3b4754] p-4 shadow-sm relative active:scale-[0.98] transition-transform cursor-grab">
<div class="absolute right-2 top-2 text-slate-300 dark:text-[#3b4754]">
<span class="material-symbols-outlined" style="font-size: 20px;">drag_indicator</span>
</div>
<div class="flex gap-3 mb-3">
<div class="p-2 bg-teal-50 dark:bg-teal-900/20 rounded-lg text-teal-600 dark:text-teal-400">
<span class="material-symbols-outlined">assignment</span>
</div>
<div>
<h3 class="font-semibold text-base">User Survey</h3>
<p class="text-xs text-slate-500 dark:text-[#9dabb9]">Quantitative Validation</p>
</div>
</div>
<div class="flex items-center gap-4 border-t border-slate-100 dark:border-[#2c333e] pt-3 mt-1">
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-slate-400 text-[16px]">payments</span>
<span class="text-xs font-medium dark:text-slate-200">$10k</span>
</div>
<div class="flex items-center gap-1.5">
<span class="material-symbols-outlined text-slate-400 text-[16px]">schedule</span>
<span class="text-xs font-medium dark:text-slate-200">3 wks</span>
</div>
<div class="ml-auto text-xs text-green-500 font-medium bg-green-500/10 px-2 py-0.5 rounded">
                                -18% Risk
                            </div>
</div>
</div>
</div>
<!-- Stop/Defer Indicator -->
<div class="relative flex gap-4 pb-8">
<div class="flex flex-col items-center pt-1">
<div class="flex h-4 w-4 items-center justify-center rounded-full bg-red-500 ring-4 ring-slate-50 dark:ring-[#111418] z-10"></div>
</div>
<div class="flex-1">
<div class="bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-800/30 rounded-lg p-3 flex gap-3 items-start">
<span class="material-symbols-outlined text-red-600 dark:text-red-400 shrink-0">warning</span>
<div class="flex flex-col gap-1">
<h4 class="text-sm font-bold text-red-900 dark:text-red-200">Stop/Defer Point Reached</h4>
<p class="text-xs text-red-700 dark:text-red-300/70 leading-relaxed">
                                    Marginal value of additional evidence is lower than the cost. Past this point, you see diminishing returns.
                                </p>
</div>
</div>
</div>
</div>
<!-- Step 4 (Diminished) -->
<div class="group relative flex gap-4 opacity-50 grayscale hover:grayscale-0 hover:opacity-100 transition-all">
<div class="flex flex-col items-center">
<div class="flex h-6 w-6 items-center justify-center rounded-full bg-slate-400 dark:bg-slate-600 text-white ring-4 ring-slate-50 dark:ring-[#111418] z-10">
<span class="text-xs font-bold">4</span>
</div>
</div>
<div class="flex-1 bg-white dark:bg-[#1c2127] rounded-lg border border-slate-200 dark:border-[#3b4754] border-dashed p-4 relative">
<div class="flex gap-3 mb-2">
<div class="p-2 bg-slate-100 dark:bg-slate-800 rounded-lg text-slate-500">
<span class="material-symbols-outlined">rocket_launch</span>
</div>
<div>
<h3 class="font-semibold text-base">Large Scale Pilot</h3>
<p class="text-xs text-slate-500 dark:text-[#9dabb9]">Market Launch</p>
</div>
</div>
<div class="flex items-center gap-4 pt-2 mt-1">
<div class="flex items-center gap-1.5">
<span class="text-xs font-medium dark:text-slate-400">$50k</span>
</div>
<div class="flex items-center gap-1.5">
<span class="text-xs font-medium dark:text-slate-400">8 wks</span>
</div>
</div>
</div>
</div>
<!-- Add Button Area -->
<div class="flex justify-center py-6 ml-10">
<button class="flex items-center gap-2 text-primary font-medium text-sm hover:text-blue-400 transition-colors">
<span class="material-symbols-outlined">add_circle</span>
                        Add Action Step
                    </button>
</div>
</div>
</div>
</main>
<!-- Sticky Footer Metrics -->
<div class="fixed bottom-0 left-0 right-0 bg-white/80 dark:bg-[#111418]/90 backdrop-blur-md border-t border-slate-200 dark:border-[#222831] p-4 pb-6 z-30">
<div class="max-w-md mx-auto">
<div class="flex items-center justify-between gap-2 mb-2">
<h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-[#9dabb9]">Plan Totals</h3>
<span class="text-[10px] bg-slate-100 dark:bg-[#222831] px-2 py-0.5 rounded-full text-slate-500 dark:text-slate-400">Auto-calculated</span>
</div>
<div class="grid grid-cols-3 gap-3">
<!-- Metric 1: Cost -->
<div class="bg-slate-50 dark:bg-[#1c2127] rounded-lg p-3 flex flex-col gap-1 border border-slate-100 dark:border-[#2c333e]">
<div class="flex items-center gap-1.5 text-slate-500 dark:text-[#9dabb9]">
<span class="material-symbols-outlined text-[18px]">attach_money</span>
<span class="text-xs font-medium">Cost</span>
</div>
<p class="text-lg font-bold text-slate-900 dark:text-white">$17k</p>
</div>
<!-- Metric 2: Time -->
<div class="bg-slate-50 dark:bg-[#1c2127] rounded-lg p-3 flex flex-col gap-1 border border-slate-100 dark:border-[#2c333e]">
<div class="flex items-center gap-1.5 text-slate-500 dark:text-[#9dabb9]">
<span class="material-symbols-outlined text-[18px]">timer</span>
<span class="text-xs font-medium">Time</span>
</div>
<p class="text-lg font-bold text-slate-900 dark:text-white">6 wks</p>
</div>
<!-- Metric 3: Risk -->
<div class="bg-orange-50 dark:bg-orange-900/10 rounded-lg p-3 flex flex-col gap-1 border border-orange-100 dark:border-orange-900/30 relative overflow-hidden">
<div class="absolute -right-2 -top-2 w-8 h-8 bg-orange-200 dark:bg-orange-800/30 rounded-full blur-xl"></div>
<div class="flex items-center gap-1.5 text-orange-600 dark:text-orange-400">
<span class="material-symbols-outlined text-[18px]">analytics</span>
<span class="text-xs font-medium">Risk</span>
</div>
<div class="flex items-baseline gap-1">
<p class="text-lg font-bold text-orange-700 dark:text-orange-200">42%</p>
<span class="text-[10px] font-medium text-orange-600/70 dark:text-orange-300/50">Med</span>
</div>
</div>
</div>
</div>
</div>
<!-- Floating Action Button (FAB) -->
<div class="fixed bottom-[140px] right-4 z-40">
<button class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-white shadow-lg shadow-blue-500/30 hover:bg-blue-600 active:scale-95 transition-all">
<span class="material-symbols-outlined" style="font-size: 28px;">add</span>
</button>
</div>
