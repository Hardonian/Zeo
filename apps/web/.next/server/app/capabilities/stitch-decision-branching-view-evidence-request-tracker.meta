{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/capabilities/layout,_N_T_/capabilities/[slug]/layout,_N_T_/capabilities/[slug]/page,_N_T_/capabilities/stitch-decision-branching-view-evidence-request-tracker"
  },
