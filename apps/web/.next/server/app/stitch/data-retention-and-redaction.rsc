f:T35d3,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Data Retention &amp; Redaction</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#13a4ec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101c22",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
        /* Custom scrollbar for horizontal scrolling elements */
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display antialiased min-h-screen flex flex-col overflow-x-hidden">
<!-- Header -->
<header class="sticky top-0 z-50 flex items-center justify-between p-4 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-sm border-b border-gray-200 dark:border-gray-800">
<div class="flex items-center gap-3">
<button class="text-gray-900 dark:text-white flex items-center justify-center p-1 hover:bg-gray-200 dark:hover:bg-white/10 rounded-full transition-colors">
<span class="material-symbols-outlined">arrow_back</span>
</button>
<h1 class="text-lg font-bold text-gray-900 dark:text-white tracking-tight">Retention &amp; Redaction</h1>
</div>
<div class="flex items-center gap-2">
<div class="flex items-center px-2 py-1 bg-green-500/10 border border-green-500/20 rounded text-xs font-bold text-green-600 dark:text-green-400">
<span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-2 animate-pulse"></span>
                SECURE
            </div>
<button class="text-gray-500 dark:text-gray-400 hover:text-primary dark:hover:text-primary transition-colors">
<span class="material-symbols-outlined">shield_lock</span>
</button>
</div>
</header>
<main class="flex-1 flex flex-col p-4 gap-6 max-w-md mx-auto w-full">
<!-- Storage Section -->
<section>
<div class="flex items-center justify-between mb-3 px-1">
<h2 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Storage Locations</h2>
<span class="text-xs text-primary font-mono">SYS.ALLOCATION</span>
</div>
<div class="flex gap-4 overflow-x-auto hide-scrollbar pb-2 -mx-4 px-4 snap-x">
<!-- Card 1 -->
<div class="flex-none w-[200px] snap-center bg-white dark:bg-[#1a262d] border border-gray-200 dark:border-gray-700 rounded-xl p-5 shadow-sm relative overflow-hidden group">
<div class="absolute top-0 right-0 p-3 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-4xl text-primary">cloud</span>
</div>
<div class="flex flex-col h-full justify-between gap-4">
<div>
<p class="text-sm font-medium text-gray-500 dark:text-gray-400">S3 Archive</p>
<p class="text-2xl font-bold text-gray-900 dark:text-white mt-1">4.2 TB</p>
</div>
<div class="space-y-2">
<div class="w-full bg-gray-100 dark:bg-gray-700 h-1.5 rounded-full overflow-hidden">
<div class="bg-primary h-full rounded-full" style="width: 75%"></div>
</div>
<div class="flex justify-between items-end">
<span class="text-xs text-gray-400 font-mono">RETENTION</span>
<span class="text-sm font-bold text-primary">365 Days</span>
</div>
</div>
</div>
</div>
<!-- Card 2 -->
<div class="flex-none w-[200px] snap-center bg-white dark:bg-[#1a262d] border border-gray-200 dark:border-gray-700 rounded-xl p-5 shadow-sm relative overflow-hidden group">
<div class="absolute top-0 right-0 p-3 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-4xl text-purple-400">database</span>
</div>
<div class="flex flex-col h-full justify-between gap-4">
<div>
<p class="text-sm font-medium text-gray-500 dark:text-gray-400">User Logs</p>
<p class="text-2xl font-bold text-gray-900 dark:text-white mt-1">120 GB</p>
</div>
<div class="space-y-2">
<div class="w-full bg-gray-100 dark:bg-gray-700 h-1.5 rounded-full overflow-hidden">
<div class="bg-purple-500 h-full rounded-full" style="width: 45%"></div>
</div>
<div class="flex justify-between items-end">
<span class="text-xs text-gray-400 font-mono">RETENTION</span>
<span class="text-sm font-bold text-purple-400">30 Days</span>
</div>
</div>
</div>
</div>
<!-- Card 3 -->
<div class="flex-none w-[200px] snap-center bg-white dark:bg-[#1a262d] border border-gray-200 dark:border-gray-700 rounded-xl p-5 shadow-sm relative overflow-hidden group">
<div class="absolute top-0 right-0 p-3 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-4xl text-orange-400">folder_zip</span>
</div>
<div class="flex flex-col h-full justify-between gap-4">
<div>
<p class="text-sm font-medium text-gray-500 dark:text-gray-400">Cold Storage</p>
<p class="text-2xl font-bold text-gray-900 dark:text-white mt-1">8.5 TB</p>
</div>
<div class="space-y-2">
<div class="w-full bg-gray-100 dark:bg-gray-700 h-1.5 rounded-full overflow-hidden">
<div class="bg-orange-400 h-full rounded-full" style="width: 90%"></div>
</div>
<div class="flex justify-between items-end">
<span class="text-xs text-gray-400 font-mono">RETENTION</span>
<span class="text-sm font-bold text-orange-400">7 Years</span>
</div>
</div>
</div>
</div>
</div>
</section>
<!-- Redaction Rules -->
<section>
<div class="flex items-center justify-between mb-3 px-1">
<h2 class="text-xs font-bold text-gray-500 dark:text-gray-400 uppercase tracking-widest">Active Redaction Rules</h2>
<button class="text-xs text-primary font-bold hover:text-primary/80 flex items-center gap-1">
<span class="material-symbols-outlined text-[14px]">add</span> NEW RULE
                </button>
</div>
<div class="flex flex-col gap-3">
<!-- Rule 1 -->
<div class="flex items-center justify-between bg-white dark:bg-[#1a262d] p-4 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
<div class="flex items-start gap-4 flex-1">
<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-blue-500/10 text-blue-500 dark:text-blue-400 shrink-0">
<span class="material-symbols-outlined">visibility_off</span>
</div>
<div class="flex flex-col min-w-0">
<h3 class="text-base font-bold text-gray-900 dark:text-white truncate">PII Masking (Email)</h3>
<code class="text-xs text-gray-500 dark:text-gray-400 font-mono bg-gray-100 dark:bg-black/30 px-1.5 py-0.5 rounded mt-1 truncate max-w-[180px]">Regex: [a-zA-Z0-9_.+-]+@</code>
</div>
</div>
<label class="relative inline-flex items-center cursor-pointer shrink-0 ml-4">
<input checked="" class="sr-only peer" type="checkbox" value=""/>
<div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-primary"></div>
</label>
</div>
<!-- Rule 2 -->
<div class="flex items-center justify-between bg-white dark:bg-[#1a262d] p-4 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
<div class="flex items-start gap-4 flex-1">
<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-purple-500/10 text-purple-500 dark:text-purple-400 shrink-0">
<span class="material-symbols-outlined">badge</span>
</div>
<div class="flex flex-col min-w-0">
<h3 class="text-base font-bold text-gray-900 dark:text-white truncate">Redact SSN</h3>
<code class="text-xs text-gray-500 dark:text-gray-400 font-mono bg-gray-100 dark:bg-black/30 px-1.5 py-0.5 rounded mt-1 truncate max-w-[180px]">Regex: \d{3}-\d{2}-\d{4}</code>
</div>
</div>
<label class="relative inline-flex items-center cursor-pointer shrink-0 ml-4">
<input checked="" class="sr-only peer" type="checkbox" value=""/>
<div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-primary"></div>
</label>
</div>
<!-- Rule 3 -->
<div class="flex items-center justify-between bg-white dark:bg-[#1a262d] p-4 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm opacity-60">
<div class="flex items-start gap-4 flex-1">
<div class="flex items-center justify-center w-10 h-10 rounded-lg bg-gray-500/10 text-gray-500 dark:text-gray-400 shrink-0">
<span class="material-symbols-outlined">credit_card</span>
</div>
<div class="flex flex-col min-w-0">
<h3 class="text-base font-bold text-gray-900 dark:text-white truncate">Credit Card Redaction</h3>
<code class="text-xs text-gray-500 dark:text-gray-400 font-mono bg-gray-100 dark:bg-black/30 px-1.5 py-0.5 rounded mt-1 truncate max-w-[180px]">PCI-DSS Standard</code>
</div>
</div>
<label class="relative inline-flex items-center cursor-pointer shrink-0 ml-4">
<input class="sr-only peer" type="checkbox" value=""/>
<div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-primary"></div>
</label>
</div>
</div>
</section>
<!-- Danger Zone -->
<section class="mt-4 mb-8">
<div class="flex items-center justify-between mb-3 px-1">
<h2 class="text-xs font-bold text-red-500 uppercase tracking-widest flex items-center gap-1">
<span class="material-symbols-outlined text-[16px]">warning</span> Danger Zone
                </h2>
</div>
<div class="bg-red-50 dark:bg-red-900/10 border border-red-200 dark:border-red-900/30 rounded-xl p-5">
<div class="flex items-start gap-3">
<div class="mt-1">
<span class="material-symbols-outlined text-red-600 dark:text-red-500">delete_forever</span>
</div>
<div>
<h3 class="text-lg font-bold text-red-700 dark:text-red-400">Purge Expired Data</h3>
<p class="text-sm text-red-600/80 dark:text-red-300/80 mt-1 leading-relaxed">
                            Permanently delete all data that has exceeded its retention window across all storage buckets. This action is irreversible.
                        </p>
</div>
</div>
<button class="w-full mt-5 bg-red-600 hover:bg-red-700 active:bg-red-800 text-white font-bold py-3 px-4 rounded-lg shadow-sm transition-all flex items-center justify-center gap-2 group">
<span>EXECUTE RETENTION PURGE</span>
<span class="material-symbols-outlined group-hover:translate-x-1 transition-transform">arrow_forward</span>
</button>
</div>
</section>
</main>
<!-- Simulated Modal (Hidden by default in real logic, shown here for visual representation) -->
<!-- Remove 'hidden' class to preview modal -->
<div class="fixed inset-0 z-[60] flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden">
<div class="bg-white dark:bg-[#1a262d] w-full max-w-sm rounded-xl border border-red-500/30 shadow-2xl p-6 relative overflow-hidden">
<!-- Decorative stripe -->
<div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-red-500 via-orange-500 to-red-500"></div>
<div class="text-center mb-6">
<div class="mx-auto flex items-center justify-center w-12 h-12 rounded-full bg-red-100 dark:bg-red-900/30 mb-4">
<span class="material-symbols-outlined text-red-600 dark:text-red-500 text-2xl">priority_high</span>
</div>
<h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Double Confirmation</h3>
<p class="text-sm text-gray-500 dark:text-gray-400">
                    You are about to permanently delete 4.2TB of archived data. This cannot be undone.
                </p>
</div>
<div class="space-y-4">
<div>
<label class="block text-xs font-mono text-gray-500 dark:text-gray-400 mb-1.5 uppercase">Type "DELETE" to confirm</label>
<input class="w-full bg-gray-50 dark:bg-black/20 border border-gray-300 dark:border-gray-700 text-gray-900 dark:text-white rounded-lg p-3 font-mono focus:ring-2 focus:ring-red-500 focus:border-red-500 outline-none transition-all placeholder:text-gray-400/30" placeholder="DELETE" type="text"/>
</div>
<div class="grid grid-cols-2 gap-3 pt-2">
<button class="w-full py-2.5 px-4 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">Cancel</button>
<button class="w-full py-2.5 px-4 rounded-lg bg-red-600 text-white font-bold hover:bg-red-700 shadow-lg shadow-red-600/20 transition-all opacity-50 cursor-not-allowed">Confirm</button>
</div>
</div>
</div>
</div>
</body></html>6:["$","div",null,{"className":"min-h-screen bg-gray-50 text-gray-900","children":[["$","header",null,{"className":"border-b border-gray-200 bg-white","children":["$","div",null,{"className":"mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-4","children":[["$","$L5",null,{"href":"/","className":"text-lg font-semibold text-blue-700","children":"Zeo"}],["$","nav",null,{"className":"flex flex-wrap items-center gap-4 text-sm","children":[[["$","$L5","/",{"href":"/","className":"text-gray-700 hover:text-blue-700","children":"Home"}],["$","$L5","/about",{"href":"/about","className":"text-gray-700 hover:text-blue-700","children":"About"}],["$","$L5","/pricing",{"href":"/pricing","className":"text-gray-700 hover:text-blue-700","children":"Pricing"}],["$","$L5","/platform",{"href":"/platform","className":"text-gray-700 hover:text-blue-700","children":"Platform"}],["$","$L5","/stitch",{"href":"/stitch","className":"text-gray-700 hover:text-blue-700","children":"Stitch Pages"}],["$","$L5","/contact",{"href":"/contact","className":"text-gray-700 hover:text-blue-700","children":"Contact"}]],["$","$L5",null,{"href":"/dashboard","className":"rounded border border-blue-200 px-3 py-1 text-blue-700 hover:bg-blue-50","children":"Dashboard"}]]}]]}]}],["$","main",null,{"className":"mx-auto w-full max-w-6xl px-6 py-10","children":[["$","h1",null,{"className":"mb-6 text-3xl font-semibold","children":"Data Retention & Redaction"}],["$","div",null,{"className":"overflow-hidden rounded border border-gray-200 bg-white","children":["$","iframe",null,{"title":"Data Retention & Redaction","srcDoc":"$f","className":"h-[900px] w-full","sandbox":"allow-scripts allow-same-origin"}]}]]}],"$L10"]}]
