<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Zeo - Decision Branching View</title>
<!-- Google Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@500&amp;display=swap" rel="stylesheet"/>
<!-- Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<!-- Tailwind CSS -->
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<!-- Theme Config -->
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#135bec",
                        "background-light": "#f6f6f8",
                        "background-dark": "#101622",
                        "surface-dark": "#192233",
                        "surface-light": "#ffffff",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"],
                        "mono": ["JetBrains Mono", "monospace"],
                    },
                    borderRadius: { "DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "full": "9999px" },
                },
            },
        }
    </script>
<style>
        /* Custom Utilities for the Canvas feel */
        .dot-pattern {
            background-image: radial-gradient(#324467 1px, transparent 1px);
            background-size: 24px 24px;
        }
        
        /* Hide Scrollbar but allow scroll */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* SVG Connection Lines Animation - subtle pulse */
        @keyframes flow {
            0% { stroke-dashoffset: 20; }
            100% { stroke-dashoffset: 0; }
        }
        .flow-line {
            stroke-dasharray: 4 4;
            animation: flow 1s linear infinite;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-white h-screen flex flex-col overflow-hidden selection:bg-primary/30">
<!-- Top Navigation -->
<header class="flex-none z-20 bg-background-light/90 dark:bg-background-dark/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-800">
<div class="flex items-center justify-between p-4">
<button class="flex size-10 items-center justify-center rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-slate-600 dark:text-gray-300">
<span class="material-symbols-outlined">chevron_left</span>
</button>
<div class="flex flex-col items-center">
<h1 class="text-sm font-medium text-slate-500 dark:text-gray-400">Decision Branching</h1>
<h2 class="text-base font-bold leading-tight">Project Alpha Launch</h2>
</div>
<div class="flex gap-2">
<button class="flex size-10 items-center justify-center rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-slate-600 dark:text-gray-300">
<span class="material-symbols-outlined">filter_list</span>
</button>
<button class="flex size-10 items-center justify-center rounded-lg bg-primary text-white shadow-lg shadow-primary/30 hover:bg-primary/90 transition-colors">
<span class="material-symbols-outlined">add</span>
</button>
</div>
</div>
<!-- Quick stats / Context bar -->
<div class="flex gap-3 px-4 pb-3 overflow-x-auto no-scrollbar">
<div class="flex h-7 shrink-0 items-center justify-center gap-x-2 rounded px-3 bg-white dark:bg-[#232f48] border border-gray-200 dark:border-transparent">
<span class="material-symbols-outlined text-[16px] text-emerald-500">trending_up</span>
<p class="text-xs font-mono font-medium">Prob: &gt;65%</p>
</div>
<div class="flex h-7 shrink-0 items-center justify-center gap-x-2 rounded px-3 bg-white dark:bg-[#232f48] border border-gray-200 dark:border-transparent">
<span class="material-symbols-outlined text-[16px] text-amber-500">warning</span>
<p class="text-xs font-medium">Risk: Med</p>
</div>
<div class="flex h-7 shrink-0 items-center justify-center gap-x-2 rounded px-3 bg-white dark:bg-[#232f48] border border-gray-200 dark:border-transparent">
<span class="material-symbols-outlined text-[16px] text-blue-400">schedule</span>
<p class="text-xs font-medium">Q4 2024</p>
</div>
</div>
</header>
<!-- Main Canvas Area -->
<main class="relative flex-1 overflow-auto no-scrollbar bg-background-light dark:bg-background-dark cursor-grab active:cursor-grabbing">
<!-- Background Grid Pattern -->
<div class="absolute inset-0 dot-pattern opacity-30 pointer-events-none h-[200%] w-[200%]"></div>
<!-- Canvas Container - Simulating a large map area centered initially -->
<div class="relative min-h-[1200px] min-w-[800px] flex flex-col items-center pt-12 pb-40">
<!-- SVG Connector Layer -->
<!-- Note: In a real app these coordinates would be dynamic. Hardcoded here for visual representation. -->
<svg class="absolute top-0 left-0 w-full h-full pointer-events-none z-0" xmlns="http://www.w3.org/2000/svg">
<defs>
<marker id="arrowhead" markerheight="7" markerwidth="10" orient="auto" refx="9" refy="3.5">
<polygon fill="#64748b" points="0 0, 10 3.5, 0 7"></polygon>
</marker>
<lineargradient id="grad1" x1="0%" x2="0%" y1="0%" y2="100%">
<stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1"></stop>
<stop offset="100%" style="stop-color:#64748b;stop-opacity:1"></stop>
</lineargradient>
</defs>
<!-- Line from Root to Left Branch -->
<path class="dark:stroke-slate-600" d="M400 130 C 400 180, 200 180, 200 240" fill="none" stroke="#475569" stroke-width="2"></path>
<!-- Line from Root to Center Branch -->
<path d="M400 130 L 400 240" fill="none" marker-end="url(#arrowhead)" stroke="#3b82f6" stroke-width="3"></path>
<!-- Line from Root to Right Branch -->
<path class="dark:stroke-slate-600" d="M400 130 C 400 180, 600 180, 600 240" fill="none" stroke="#475569" stroke-dasharray="4" stroke-width="2"></path>
<!-- Line from Center Branch to Sub-Node -->
<path class="dark:stroke-slate-600" d="M400 340 L 400 440" fill="none" stroke="#475569" stroke-width="2"></path>
</svg>
<!-- Root Decision Node -->
<div class="relative z-10 mb-20">
<div class="bg-white dark:bg-[#192233] rounded-xl shadow-[0_0_20px_rgba(19,91,236,0.3)] border-2 border-primary p-4 w-64 text-center">
<div class="mb-2 inline-flex items-center justify-center rounded bg-primary/20 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-primary">Root Decision</div>
<h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">Launch Product in Q4</h3>
<p class="text-xs text-slate-500 dark:text-slate-400">Status: Active evaluation</p>
</div>
<!-- Collapse Point Marker on the line -->
<div class="absolute -bottom-16 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center">
<div class="size-4 rotate-45 bg-amber-500 border-2 border-background-light dark:border-background-dark shadow-sm"></div>
<span class="mt-1 text-[10px] font-mono text-slate-500 dark:text-slate-400 bg-background-light/80 dark:bg-background-dark/80 px-1 rounded">Oct 15</span>
</div>
</div>
<!-- Level 1 Nodes Container -->
<div class="grid grid-cols-3 gap-12 w-[700px] justify-items-center mb-24">
<!-- Node Left -->
<div class="relative group">
<div class="bg-white dark:bg-[#192233] hover:border-primary/50 transition-colors cursor-pointer rounded-lg border border-gray-200 dark:border-slate-700 p-4 w-48 shadow-lg">
<div class="flex justify-between items-start mb-2">
<span class="material-symbols-outlined text-rose-500 text-lg">trending_down</span>
<span class="bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 text-xs font-mono px-2 py-0.5 rounded">20-30%</span>
</div>
<h4 class="font-semibold text-sm mb-2">Competitor Price Cut</h4>
<p class="text-[10px] text-slate-500 leading-tight">If they react aggressively to our entry.</p>
</div>
</div>
<!-- Node Center (Primary Path) -->
<div class="relative group">
<div class="bg-white dark:bg-[#192233] ring-2 ring-primary/50 ring-offset-2 ring-offset-background-light dark:ring-offset-background-dark cursor-pointer rounded-lg border border-transparent p-4 w-52 shadow-xl shadow-primary/10">
<div class="flex justify-between items-start mb-2">
<span class="material-symbols-outlined text-emerald-500 text-lg">verified</span>
<span class="bg-primary text-white text-xs font-mono font-bold px-2 py-0.5 rounded">50-60%</span>
</div>
<h4 class="font-semibold text-sm mb-2">Steady Adoption</h4>
<p class="text-[10px] text-slate-400 leading-tight mb-2">Market absorbs new supply without major price shifts.</p>
<div class="flex gap-1">
<span class="size-1.5 rounded-full bg-slate-500"></span>
<span class="size-1.5 rounded-full bg-slate-500"></span>
<span class="size-1.5 rounded-full bg-slate-500"></span>
</div>
</div>
</div>
<!-- Node Right -->
<div class="relative group opacity-70 hover:opacity-100 transition-opacity">
<div class="bg-white dark:bg-[#192233] cursor-pointer rounded-lg border border-gray-200 dark:border-slate-700 border-dashed p-4 w-48 shadow-sm">
<div class="flex justify-between items-start mb-2">
<span class="material-symbols-outlined text-slate-400 text-lg">question_mark</span>
<span class="bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-xs font-mono px-2 py-0.5 rounded">&lt; 15%</span>
</div>
<h4 class="font-semibold text-sm mb-2 text-slate-600 dark:text-slate-300">Supply Chain Fail</h4>
<p class="text-[10px] text-slate-500 leading-tight">Risk of raw material shortage in Q4.</p>
</div>
</div>
</div>
<!-- Level 2 Nodes (Connected to Center) -->
<div class="flex flex-col items-center">
<div class="bg-white dark:bg-[#192233] cursor-pointer rounded-lg border border-gray-200 dark:border-slate-700 p-3 w-44 shadow-lg flex items-center gap-3">
<div class="bg-emerald-500/10 p-1.5 rounded text-emerald-500 shrink-0">
<span class="material-symbols-outlined text-lg">monetization_on</span>
</div>
<div>
<h4 class="font-semibold text-xs mb-0.5">Revenue Target</h4>
<span class="text-[10px] font-mono text-emerald-500">+$2.4M ARR</span>
</div>
</div>
</div>
</div>
</main>
<!-- Bottom Sheet / Detail Panel (Simulated Overlay) -->
<div class="absolute bottom-[80px] left-2 right-2 z-30 flex flex-col justify-end pointer-events-none">
<!-- Floating Detail Card -->
<div class="pointer-events-auto bg-white/95 dark:bg-[#192233]/95 backdrop-blur-xl border border-gray-200 dark:border-slate-700 rounded-2xl shadow-2xl p-0 overflow-hidden transform transition-transform translate-y-0">
<!-- Drag Handle -->
<div class="w-full flex justify-center pt-3 pb-1 cursor-grab active:cursor-grabbing">
<div class="w-12 h-1.5 bg-gray-300 dark:bg-slate-600 rounded-full"></div>
</div>
<div class="px-5 pb-5">
<div class="flex justify-between items-start mb-4">
<div>
<div class="flex items-center gap-2 mb-1">
<h3 class="text-lg font-bold">Steady Adoption</h3>
<span class="bg-emerald-500/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-bold px-2 py-0.5 rounded uppercase tracking-wide">Plausible</span>
</div>
<p class="text-sm text-slate-500 dark:text-slate-400">High confidence outcome based on Q3 data.</p>
</div>
<button class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
<span class="material-symbols-outlined">close</span>
</button>
</div>
<!-- Tabs -->
<div class="flex border-b border-gray-200 dark:border-slate-700 mb-4">
<button class="pb-2 px-4 text-sm font-medium text-primary border-b-2 border-primary">Facts &amp; Data</button>
<button class="pb-2 px-4 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">Beliefs</button>
<button class="pb-2 px-4 text-sm font-medium text-slate-500 dark:text-slate-400 hover:text-slate-800 dark:hover:text-slate-200">Assumptions</button>
</div>
<!-- Content -->
<div class="space-y-3">
<div class="flex items-start gap-3 p-3 bg-background-light dark:bg-background-dark rounded-lg">
<span class="material-symbols-outlined text-primary text-xl mt-0.5">analytics</span>
<div class="flex-1">
<p class="text-xs font-semibold uppercase text-slate-500 mb-1">Evidence</p>
<p class="text-sm font-medium leading-snug">Q3 Customer Survey shows 78% intent to purchase upgrade.</p>
<a class="inline-flex items-center gap-1 text-xs text-primary mt-2 font-medium" href="#">
                                View Report <span class="material-symbols-outlined text-[14px]">open_in_new</span>
</a>
</div>
</div>
</div>
</div>
</div>
</div>
<!-- Bottom Navigation Bar -->
<nav class="flex-none bg-background-light dark:bg-background-dark border-t border-gray-200 dark:border-gray-800 pb-safe pt-2 px-6 h-[80px]">
<div class="flex justify-between items-center h-full pb-2">
<button class="flex flex-col items-center gap-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 w-16 group">
<span class="material-symbols-outlined group-hover:-translate-y-0.5 transition-transform">dashboard</span>
<span class="text-[10px] font-medium">Dashboard</span>
</button>
<button class="flex flex-col items-center gap-1 text-primary w-16 relative">
<div class="absolute -top-3 w-10 h-0.5 bg-primary rounded-b-full shadow-[0_0_8px_rgba(19,91,236,0.8)]"></div>
