f:T3422,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Zeo - Structured Debate Panel</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;family=Noto+Sans:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#135bec",
                        "background-light": "#f6f6f8",
                        "background-dark": "#0f0f12",
                        "surface-dark": "#18181b",
                        "surface-light": "#ffffff",
                        "tension": "#f59e0b", // Amber
                        "agreement": "#14b8a6", // Teal
                        "neutral-gray": "#92a4c9",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"],
                        "body": ["Noto Sans", "sans-serif"],
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
        .scrollbar-hide::-webkit-scrollbar {
            display: none;
        }
        .scrollbar-hide {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display antialiased text-gray-900 dark:text-white overflow-hidden h-screen flex flex-col w-full max-w-md mx-auto shadow-2xl relative border-x border-gray-200 dark:border-gray-800">
<!-- Header -->
<header class="flex items-center bg-surface-light dark:bg-surface-dark px-4 py-3 justify-between border-b border-gray-200 dark:border-gray-800 z-10 shrink-0">
<button class="text-gray-500 dark:text-gray-400 flex size-10 shrink-0 items-center justify-center rounded-full hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
<span class="material-symbols-outlined text-[24px]">expand_more</span>
</button>
<div class="flex flex-col items-center">
<h2 class="text-gray-900 dark:text-white text-sm font-bold uppercase tracking-wider">Structured Debate</h2>
<span class="text-xs text-neutral-gray">Conflict Resolution Mode</span>
</div>
<button class="text-primary font-bold text-sm shrink-0 px-2 py-1 rounded hover:bg-primary/10 transition-colors">
            Resolve
        </button>
</header>
<!-- Scrollable Content Area -->
<main class="flex-1 overflow-y-auto scrollbar-hide pb-24">
<!-- Assumption Title -->
<div class="px-5 pt-6 pb-2">
<div class="flex items-center gap-2 mb-1">
<span class="px-1.5 py-0.5 rounded text-[10px] font-bold uppercase bg-tension/20 text-tension border border-tension/30">Active Dispute</span>
<span class="text-xs text-neutral-gray">#ASP-402</span>
</div>
<h1 class="text-2xl md:text-[28px] font-bold leading-tight text-gray-900 dark:text-white">Assumption Conflict: Q4 Growth</h1>
</div>
<!-- Divergent Belief Ranges (Visualization) -->
<div class="px-5 py-4">
<div class="bg-surface-light dark:bg-surface-dark rounded-xl border border-gray-200 dark:border-gray-800 p-4 shadow-sm">
<div class="flex justify-between items-end mb-4">
<div>
<p class="text-neutral-gray text-xs font-bold uppercase tracking-wider">Divergence Gap</p>
<p class="text-tension text-2xl font-bold font-display">50% <span class="text-sm font-normal text-gray-500 dark:text-gray-400">spread</span></p>
</div>
<div class="flex items-center gap-1 text-xs text-neutral-gray bg-gray-100 dark:bg-gray-800/50 px-2 py-1 rounded">
<span class="material-symbols-outlined text-[14px]">analytics</span>
<span>Probability density</span>
</div>
</div>
<!-- Range Chart -->
<div class="relative h-16 w-full bg-gray-100 dark:bg-[#232f48] rounded-lg overflow-hidden flex items-center mb-3">
<!-- Grid lines -->
<div class="absolute inset-0 grid grid-cols-4 border-gray-200 dark:border-gray-700/30 divide-x divide-dashed divide-gray-300 dark:divide-gray-600/30">
<div></div><div></div><div></div><div></div>
</div>
<!-- Range A -->
<div class="absolute top-2 bottom-2 left-[10%] w-[10%] bg-blue-500/30 border-l-2 border-r-2 border-blue-500 rounded-sm z-10 group">
<div class="absolute -top-1 left-1/2 -translate-x-1/2 -translate-y-full opacity-0 group-hover:opacity-100 transition-opacity bg-blue-600 text-white text-[10px] px-1 rounded whitespace-nowrap">User A</div>
</div>
<!-- Conflict Zone -->
<div class="absolute top-4 bottom-4 left-[20%] w-[50%] bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSJ0cmFuc3BhcmVudCIvPgo8cGF0aCBkPSJNLTEgMUw1IDdNLTEgNUw1IDExIiBzdHJva2U9IiNmNTllMGIiIHN0cm9rZS13aWR0aD0iMSIgb3BhY2l0eT0iMC4zIi8+Cjwvc3ZnPg==')] opacity-50 z-0"></div>
<!-- Range B -->
<div class="absolute top-2 bottom-2 left-[70%] w-[10%] bg-purple-500/30 border-l-2 border-r-2 border-purple-500 rounded-sm z-10 group">
<div class="absolute -top-1 left-1/2 -translate-x-1/2 -translate-y-full opacity-0 group-hover:opacity-100 transition-opacity bg-purple-600 text-white text-[10px] px-1 rounded whitespace-nowrap">User B</div>
</div>
</div>
<div class="flex justify-between text-[11px] font-bold text-neutral-gray font-display uppercase tracking-wide">
<div class="flex items-center gap-1.5">
<div class="size-2 rounded-full bg-blue-500"></div>
                        User A (10-20%)
                    </div>
<div class="flex items-center gap-1.5">
<div class="size-2 rounded-full bg-purple-500"></div>
                        User B (70-80%)
                    </div>
</div>
</div>
</div>
<!-- Common Ground Section -->
<div class="px-5 pb-6">
<h3 class="text-xs font-bold text-neutral-gray uppercase tracking-widest mb-3 flex items-center gap-2">
<span class="material-symbols-outlined text-agreement text-[16px]">handshake</span>
                Common Ground
            </h3>
<div class="flex flex-col gap-2">
<div class="flex items-start gap-3 p-3 rounded-lg bg-agreement/5 border border-agreement/20">
<div class="text-agreement mt-0.5">
<span class="material-symbols-outlined text-[18px]">check_circle</span>
</div>
<div>
<p class="text-sm font-medium text-gray-900 dark:text-gray-200">Market Cap is &gt;$50B</p>
<p class="text-[10px] text-neutral-gray mt-0.5 font-display">Source: Bloomberg API • Verified 2h ago</p>
</div>
</div>
<div class="flex items-start gap-3 p-3 rounded-lg bg-agreement/5 border border-agreement/20">
<div class="text-agreement mt-0.5">
<span class="material-symbols-outlined text-[18px]">check_circle</span>
</div>
<div>
<p class="text-sm font-medium text-gray-900 dark:text-gray-200">Competitor X is exiting market</p>
<p class="text-[10px] text-neutral-gray mt-0.5 font-display">Source: Q3 Earnings Call</p>
</div>
</div>
</div>
</div>
<div class="h-px bg-gray-200 dark:bg-gray-800 mx-5 mb-6"></div>
<!-- Evidence Duel Section -->
<div class="px-5">
<div class="flex items-center justify-between mb-4">
<h3 class="text-xs font-bold text-neutral-gray uppercase tracking-widest flex items-center gap-2">
<span class="material-symbols-outlined text-tension text-[16px]">swords</span>
                    Evidence Duel
                </h3>
<span class="text-[10px] px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-800 text-neutral-gray">3 Active Threads</span>
</div>
<!-- Stance A -->
<div class="mb-6">
<div class="flex items-center justify-between mb-3 px-1">
<span class="text-sm font-bold text-blue-500">Stance A (Bearish)</span>
<span class="text-[10px] font-mono text-neutral-gray">Confidence: 65%</span>
</div>
<div class="flex flex-col gap-3">
<!-- Card 1 -->
<div class="group relative bg-surface-light dark:bg-surface-dark border border-gray-200 dark:border-gray-800 rounded-lg p-3 hover:border-blue-500/50 transition-colors cursor-pointer shadow-sm">
<div class="flex justify-between items-start mb-2">
<span class="text-[10px] font-mono text-neutral-gray bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded">#EV-102</span>
<div class="flex gap-1">
<span class="size-2 rounded-full bg-blue-500"></span>
<span class="size-2 rounded-full bg-blue-500/30"></span>
<span class="size-2 rounded-full bg-blue-500/30"></span>
</div>
</div>
<p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2 leading-snug">Historical Trend Analysis shows cyclical downturn</p>
<div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 dark:border-gray-800">
<span class="text-[10px] font-bold text-green-600 dark:text-green-400 flex items-center gap-1">
<span class="material-symbols-outlined text-[12px]">verified_user</span> High Trust
                            </span>
<span class="text-[10px] font-bold uppercase text-neutral-gray">Impact: High</span>
</div>
</div>
<!-- Card 2 -->
<div class="group relative bg-surface-light dark:bg-surface-dark border border-gray-200 dark:border-gray-800 rounded-lg p-3 hover:border-blue-500/50 transition-colors cursor-pointer shadow-sm opacity-70">
<div class="flex justify-between items-start mb-2">
<span class="text-[10px] font-mono text-neutral-gray bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 rounded">#EV-105</span>
<div class="flex gap-1">
<span class="size-2 rounded-full bg-blue-500"></span>
<span class="size-2 rounded-full bg-gray-700/30"></span>
<span class="size-2 rounded-full bg-gray-700/30"></span>
</div>
</div>
<p class="text-sm font-medium text-gray-900 dark:text-gray-300 mb-2 leading-snug">CEO Statement regarding supply chain risks</p>
<div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 dark:border-gray-800">
<span class="text-[10px] font-bold text-neutral-gray flex items-center gap-1">
<span class="material-symbols-outlined text-[12px]">help</span> Unverified
                            </span>
<span class="text-[10px] font-bold uppercase text-neutral-gray">Impact: Low</span>
</div>
</div>
</div>
</div>
<!-- Stance B -->
<div class="mb-8">
<div class="flex items-center justify-between mb-3 px-1">
<span class="text-sm font-bold text-purple-500">Stance B (Bullish)</span>
<span class="text-[10px] font-mono text-neutral-gray">Confidence: 82%</span>
</div>
<div class="flex flex-col gap-3">
<!-- Card 3 -->
<div class="group relative bg-surface-light dark:bg-surface-dark border-l-4 border-l-tension border-y border-r border-gray-200 dark:border-y-gray-800 dark:border-r-gray-800 rounded-lg p-3 hover:bg-gray-50 dark:hover:bg-gray-800/30 transition-colors cursor-pointer shadow-sm">
<div class="flex justify-between items-start mb-2">
<span class="text-[10px] font-mono text-tension bg-tension/10 px-1.5 py-0.5 rounded border border-tension/20">#EV-299 • Disputed</span>
<div class="flex gap-1">
<span class="size-2 rounded-full bg-purple-500"></span>
<span class="size-2 rounded-full bg-purple-500"></span>
<span class="size-2 rounded-full bg-purple-500"></span>
</div>
</div>
<p class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2 leading-snug">Supply Chain Audit Report Q3 2024</p>
<p class="text-xs text-neutral-gray mb-3 line-clamp-2">Direct contradiction to CEO statement. Audit reveals 20% surplus inventory capability for Q4.</p>
<div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 dark:border-gray-800">
<span class="text-[10px] font-bold text-green-600 dark:text-green-400 flex items-center gap-1">
<span class="material-symbols-outlined text-[12px]">verified_user</span> High Trust
                            </span>
<span class="text-[10px] font-bold uppercase text-tension">Impact: Critical</span>
</div>
</div>
</div>
</div>
</div>
<!-- Bottom Spacer -->
<div class="h-24"></div>
</main>
<!-- Footer Action Bar -->
<div class="absolute bottom-0 left-0 right-0 bg-surface-light dark:bg-surface-dark border-t border-gray-200 dark:border-gray-800 p-4 z-20">
<!-- Status Bar -->
<div class="flex justify-between items-center mb-4 text-xs font-display">
<span class="text-neutral-gray">Convergence Probability</span>
<div class="flex items-center gap-2">
<div class="w-24 h-1.5 bg-gray-200 dark:bg-gray-800 rounded-full overflow-hidden">
<div class="h-full bg-primary w-[35%] rounded-full"></div>
</div>
<span class="font-bold text-gray-900 dark:text-white">35%</span>
</div>
</div>
<!-- Main Action -->
<button class="w-full flex items-center justify-center gap-2 bg-primary hover:bg-blue-600 text-white font-bold py-3.5 px-4 rounded-lg shadow-lg shadow-blue-500/20 transition-all active:scale-[0.98]">
<span class="material-symbols-outlined text-[20px]">add_circle</span>
            Call for New Evidence
        </button>
<div class="text-center mt-2">
<p class="text-[10px] text-neutral-gray">Define an observation to resolve #EV-299</p>
</div>
</div>
