f:T3d52,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Zeo - Model Calibration Panel</title>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=JetBrains+Mono:wght@400;500;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#135bec",
                        "background-light": "#f6f6f8",
                        "background-dark": "#101622",
                        "surface-dark": "#1e293b",
                        "surface-light": "#ffffff",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"],
                        "mono": ["JetBrains Mono", "monospace"],
                    },
                    borderRadius: {"DEFAULT": "0.375rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-white font-display antialiased overflow-x-hidden pb-20">
<!-- Header -->
<header class="sticky top-0 z-50 flex items-center justify-between px-4 py-3 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
<button class="p-2 -ml-2 rounded-full hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">
<span class="material-symbols-outlined text-slate-600 dark:text-slate-300">arrow_back</span>
</button>
<h1 class="text-base font-semibold tracking-tight">Calibration: Model V3.1</h1>
<button class="p-2 -mr-2 rounded-full hover:bg-slate-200 dark:hover:bg-slate-800 transition-colors">
<span class="material-symbols-outlined text-slate-600 dark:text-slate-300">share</span>
</button>
</header>
<!-- Warning Banner -->
<div class="mx-4 mt-4 p-4 rounded-lg bg-amber-500/10 border border-amber-500/20 flex flex-col gap-3">
<div class="flex items-start gap-3">
<span class="material-symbols-outlined text-amber-500 mt-0.5 shrink-0">warning</span>
<div class="flex-1">
<h3 class="text-sm font-semibold text-amber-500 mb-1">Poor Calibration Detected</h3>
<p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                    Brier score exceeds the threshold (0.20). Historical ranges suggest over-confidence in recent forecasts.
                </p>
</div>
</div>
<button class="w-full py-2 px-4 bg-amber-500 hover:bg-amber-600 text-black text-xs font-bold uppercase tracking-wider rounded transition-colors">
            Review Assumptions
        </button>
</div>
<!-- Metrics Grid -->
<div class="grid grid-cols-2 gap-4 px-4 mt-6">
<!-- Brier Score -->
<div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 p-4 rounded-lg flex flex-col justify-between h-32 relative overflow-hidden group">
<div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-4xl">analytics</span>
</div>
<div class="flex justify-between items-start">
<span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Brier Score</span>
<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                    GOOD
                </span>
</div>
<div>
<span class="font-mono text-3xl font-bold tracking-tight">0.24</span>
<div class="mt-1 flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400">
<span class="material-symbols-outlined text-[14px]">trending_down</span>
<span>-2.4% vs last run</span>
</div>
</div>
</div>
<!-- Log Score -->
<div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 p-4 rounded-lg flex flex-col justify-between h-32 relative overflow-hidden group">
<div class="absolute top-0 right-0 p-2 opacity-10 group-hover:opacity-20 transition-opacity">
<span class="material-symbols-outlined text-4xl">functions</span>
</div>
<div class="flex justify-between items-start">
<span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider">Log Score</span>
<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                    WARNING
                </span>
</div>
<div>
<span class="font-mono text-3xl font-bold tracking-tight">0.68</span>
<div class="mt-1 flex items-center gap-1 text-xs text-amber-600 dark:text-amber-400">
<span class="material-symbols-outlined text-[14px]">trending_up</span>
<span>+5.1% vs last run</span>
</div>
</div>
</div>
</div>
<!-- Calibration Curve Section -->
<div class="mt-8 px-4">
<div class="flex items-center justify-between mb-4">
<h2 class="text-lg font-bold text-slate-800 dark:text-white">Calibration Curve</h2>
<button class="p-1 rounded hover:bg-slate-200 dark:hover:bg-slate-800">
<span class="material-symbols-outlined text-slate-400 text-xl">info</span>
</button>
</div>
<div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 rounded-lg p-5">
<div class="flex justify-between items-baseline mb-6">
<div>
<div class="text-xs text-slate-500 dark:text-slate-400 mb-1">Reliability</div>
<div class="text-2xl font-bold font-mono">0.85 <span class="text-sm font-normal text-slate-400 font-display">Correlation</span></div>
</div>
<div class="flex gap-4 text-xs">
<div class="flex items-center gap-2">
<div class="w-3 h-0.5 border-t border-dashed border-slate-400 w-4"></div>
<span class="text-slate-500">Perfect</span>
</div>
<div class="flex items-center gap-2">
<div class="w-3 h-3 rounded-full bg-primary"></div>
<span class="text-slate-500">Model</span>
</div>
</div>
</div>
<!-- Chart SVG -->
<div class="relative w-full aspect-[4/3]">
<!-- Y-axis Label -->
<div class="absolute -left-6 top-1/2 -translate-y-1/2 -rotate-90 text-[10px] text-slate-400 tracking-wider uppercase">Actual Frequency</div>
<svg class="w-full h-full overflow-visible" viewbox="0 0 400 300">
<!-- Grid Lines -->
<g class="stroke-slate-200 dark:stroke-slate-700" stroke-dasharray="4 4" stroke-width="1">
<line opacity="0.3" x1="40" x2="380" y1="260" y2="260"></line>
<line opacity="0.3" x1="40" x2="380" y1="200" y2="200"></line>
<line opacity="0.3" x1="40" x2="380" y1="140" y2="140"></line>
<line opacity="0.3" x1="40" x2="380" y1="80" y2="80"></line>
<line opacity="0.3" x1="40" x2="380" y1="20" y2="20"></line>
</g>
<!-- Perfect Calibration Line (Diagonal) -->
<line opacity="0.6" stroke="#94a3b8" stroke-dasharray="6 4" stroke-width="1.5" x1="40" x2="380" y1="260" y2="20"></line>
<!-- Model Performance Line -->
<!-- Points: (0,0), (0.2, 0.15), (0.4, 0.45), (0.6, 0.55), (0.8, 0.75), (1.0, 0.9) -->
<!-- Mapped to 340 width, 240 height starting at 40, 260 -->
<path class="drop-shadow-lg" d="M40 260 L108 224 L176 152 L244 128 L312 80 L380 44" fill="none" stroke="#135bec" stroke-linecap="round" stroke-linejoin="round" stroke-width="3"></path>
<!-- Data Points -->
<circle class="stroke-white dark:stroke-surface-dark" cx="40" cy="260" fill="#135bec" r="4" stroke-width="2"></circle>
<circle class="stroke-white dark:stroke-surface-dark" cx="108" cy="224" fill="#135bec" r="4" stroke-width="2"></circle>
<circle class="stroke-white dark:stroke-surface-dark" cx="176" cy="152" fill="#135bec" r="4" stroke-width="2"></circle>
<circle class="stroke-white dark:stroke-surface-dark" cx="244" cy="128" fill="#135bec" r="4" stroke-width="2"></circle>
<circle class="stroke-white dark:stroke-surface-dark" cx="312" cy="80" fill="#135bec" r="4" stroke-width="2"></circle>
<circle class="stroke-white dark:stroke-surface-dark" cx="380" cy="44" fill="#135bec" r="4" stroke-width="2"></circle>
<!-- Axes -->
<line class="text-slate-300 dark:text-slate-600" stroke="currentColor" stroke-width="1" x1="40" x2="380" y1="260" y2="260"></line>
<line class="text-slate-300 dark:text-slate-600" stroke="currentColor" stroke-width="1" x1="40" x2="40" y1="260" y2="20"></line>
<!-- Labels X -->
<g class="text-[10px] fill-slate-400 font-mono" text-anchor="middle">
<text x="40" y="280">0.0</text>
<text x="108" y="280">0.2</text>
<text x="176" y="280">0.4</text>
<text x="244" y="280">0.6</text>
<text x="312" y="280">0.8</text>
<text x="380" y="280">1.0</text>
</g>
</svg>
<!-- X-axis Label -->
<div class="text-center mt-1 text-[10px] text-slate-400 tracking-wider uppercase">Predicted Probability</div>
</div>
</div>
</div>
<!-- Coverage Intervals -->
<div class="mt-8 px-4">
<h2 class="text-lg font-bold text-slate-800 dark:text-white mb-4">Coverage of Intervals</h2>
<div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 rounded-lg overflow-hidden">
<!-- Header -->
<div class="grid grid-cols-3 bg-slate-50 dark:bg-slate-800/50 p-3 border-b border-slate-200 dark:border-slate-700">
<div class="text-xs font-semibold text-slate-500 uppercase">Target</div>
<div class="text-xs font-semibold text-slate-500 uppercase text-center">Actual</div>
<div class="text-xs font-semibold text-slate-500 uppercase text-right">Status</div>
</div>
<!-- Row 1 -->
<div class="grid grid-cols-3 p-4 border-b border-slate-100 dark:border-slate-800 items-center">
<div class="font-mono text-sm font-bold">50%</div>
<div class="font-mono text-sm text-center">48%</div>
<div class="flex justify-end">
<span class="inline-flex items-center px-2 py-1 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        +Accurate
                    </span>
</div>
</div>
<!-- Row 2 -->
<div class="grid grid-cols-3 p-4 border-b border-slate-100 dark:border-slate-800 items-center">
<div class="font-mono text-sm font-bold">80%</div>
<div class="font-mono text-sm text-center text-amber-600 dark:text-amber-400">65%</div>
<div class="flex justify-end">
<span class="inline-flex items-center px-2 py-1 rounded text-[10px] font-medium bg-amber-500/10 text-amber-600 dark:text-amber-400">
                        -Under Conf
                    </span>
</div>
</div>
<!-- Row 3 -->
<div class="grid grid-cols-3 p-4 items-center">
<div class="font-mono text-sm font-bold">95%</div>
<div class="font-mono text-sm text-center">94%</div>
<div class="flex justify-end">
<span class="inline-flex items-center px-2 py-1 rounded text-[10px] font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                        +Accurate
                    </span>
</div>
</div>
</div>
</div>
<!-- Confidence Buckets -->
<div class="mt-8 px-4 mb-24">
<h2 class="text-lg font-bold text-slate-800 dark:text-white mb-4">Confidence Distribution</h2>
<div class="bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-700 rounded-lg p-5">
<div class="flex flex-col gap-4">
<!-- Bucket 0-20 -->
<div class="flex items-center gap-3">
<span class="w-12 text-xs font-mono text-slate-500 text-right">0-20%</span>
<div class="flex-1 h-8 bg-slate-100 dark:bg-slate-800 rounded relative overflow-hidden">
<div class="absolute top-0 left-0 h-full bg-primary/20 dark:bg-primary/30 w-[15%]"></div>
<div class="absolute top-0 left-0 h-full bg-primary w-[12%] rounded-r flex items-center justify-end pr-2">
</div>
</div>
<span class="w-8 text-xs font-mono font-bold text-right">12%</span>
</div>
<!-- Bucket 20-40 -->
<div class="flex items-center gap-3">
<span class="w-12 text-xs font-mono text-slate-500 text-right">20-40%</span>
<div class="flex-1 h-8 bg-slate-100 dark:bg-slate-800 rounded relative overflow-hidden">
<div class="absolute top-0 left-0 h-full bg-primary/20 dark:bg-primary/30 w-[20%]"></div>
<div class="absolute top-0 left-0 h-full bg-primary w-[25%] rounded-r flex items-center justify-end pr-2">
</div>
</div>
<span class="w-8 text-xs font-mono font-bold text-right">25%</span>
</div>
<!-- Bucket 40-60 -->
<div class="flex items-center gap-3">
<span class="w-12 text-xs font-mono text-slate-500 text-right">40-60%</span>
<div class="flex-1 h-8 bg-slate-100 dark:bg-slate-800 rounded relative overflow-hidden">
<div class="absolute top-0 left-0 h-full bg-primary/20 dark:bg-primary/30 w-[45%]"></div>
<!-- Over confident visual cue -->
<div class="absolute top-0 left-0 h-full bg-amber-500 w-[52%] rounded-r flex items-center justify-end pr-2">
</div>
</div>
<span class="w-8 text-xs font-mono font-bold text-right text-amber-500">52%</span>
</div>
<!-- Bucket 60-80 -->
<div class="flex items-center gap-3">
<span class="w-12 text-xs font-mono text-slate-500 text-right">60-80%</span>
<div class="flex-1 h-8 bg-slate-100 dark:bg-slate-800 rounded relative overflow-hidden">
<div class="absolute top-0 left-0 h-full bg-primary/20 dark:bg-primary/30 w-[10%]"></div>
<div class="absolute top-0 left-0 h-full bg-primary w-[8%] rounded-r flex items-center justify-end pr-2">
</div>
</div>
<span class="w-8 text-xs font-mono font-bold text-right">8%</span>
</div>
<!-- Bucket 80-100 -->
<div class="flex items-center gap-3">
<span class="w-12 text-xs font-mono text-slate-500 text-right">80-100%</span>
<div class="flex-1 h-8 bg-slate-100 dark:bg-slate-800 rounded relative overflow-hidden">
<div class="absolute top-0 left-0 h-full bg-primary/20 dark:bg-primary/30 w-[10%]"></div>
<div class="absolute top-0 left-0 h-full bg-primary w-[3%] rounded-r flex items-center justify-end pr-2">
</div>
</div>
<span class="w-8 text-xs font-mono font-bold text-right">3%</span>
</div>
</div>
<p class="text-[10px] text-slate-500 mt-4 text-center">Light bar indicates predicted frequency. Solid bar indicates actuals.</p>
</div>
</div>
<!-- Bottom Navigation -->
<nav class="fixed bottom-0 w-full bg-white/90 dark:bg-background-dark/90 backdrop-blur-lg border-t border-slate-200 dark:border-slate-800 z-50 pb-safe">
<div class="flex justify-around items-center h-16">
<a class="flex flex-col items-center gap-1 p-2 text-slate-400 hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-2xl">dashboard</span>
<span class="text-[10px] font-medium">Dashboard</span>
</a>
<a class="flex flex-col items-center gap-1 p-2 text-slate-400 hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-2xl">account_tree</span>
<span class="text-[10px] font-medium">Tree View</span>
</a>
<a class="flex flex-col items-center gap-1 p-2 text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-2xl fill-current">fact_check</span>
<span class="text-[10px] font-medium">Evidence</span>
</a>
<a class="flex flex-col items-center gap-1 p-2 text-slate-400 hover:text-primary transition-colors" href="#">
<span class="material-symbols-outlined text-2xl">settings</span>
<span class="text-[10px] font-medium">Settings</span>
</a>
</div>
</nav>
<style>
        .pb-safe {
            padding-bottom: env(safe-area-inset-bottom, 20px);
        }
    </style>
