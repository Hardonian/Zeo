f:T3b12,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>User Epistemic Profile - Zeo</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#0dccf2",
                        "background-light": "#f5f8f8",
                        "background-dark": "#101f22",
                        "surface-dark": "#1a2c30",
                        "surface-darker": "#152629",
                        "accent-cyan": "#0dccf2",
                        "accent-amber": "#ffb020",
                        "accent-emerald": "#00d26a",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "2xl": "1rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
        body {
            font-family: "Space Grotesk", sans-serif;
        }
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen overflow-x-hidden">
<div class="max-w-md mx-auto min-h-screen flex flex-col relative pb-20">
<!-- Header -->
<header class="sticky top-0 z-50 bg-background-light/95 dark:bg-background-dark/95 backdrop-blur-md border-b border-slate-200 dark:border-slate-800 px-4 py-3 flex items-center justify-between">
<div class="flex items-center gap-3">
<div class="relative">
<img alt="Portrait of a user with glasses" class="w-10 h-10 rounded-full object-cover border-2 border-primary/30" data-alt="User profile picture" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBWR7YptmBBwZ8jvujNmI0PvikEaW2YUUmd8FSj-MoQq1NjAY4pPTsLOmCzMcF0cDd7mk4qCaS04n5W2D7IUk8RDUjF0SXuGclD_QRgNmHl5zb2o-OnIYwKumtQIiNrJxzy60DSUUqloSjtm9Cnt2mLH-MY2rt_z5vojNKVMpvnBj-2dd8RCZb6qo0ssuUidh6fVibgHt1L6IzXjdPf15lIFq3TrDAQeImT5jjFQkTlDA2ojcIZTRMRtF1Yw2JPCRHUGROJKOj9feU"/>
<div class="absolute bottom-0 right-0 w-3 h-3 bg-accent-emerald rounded-full border-2 border-background-dark"></div>
</div>
<div>
<h1 class="text-sm font-bold leading-none tracking-tight text-slate-900 dark:text-white">Alex Chen</h1>
<p class="text-xs text-slate-500 dark:text-slate-400 font-medium tracking-wide">SR. ANALYST</p>
</div>
</div>
<button class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-slate-200 dark:hover:bg-surface-dark transition-colors text-slate-500 dark:text-slate-400">
<span class="material-symbols-outlined">share</span>
</button>
</header>
<!-- Main Scrollable Content -->
<main class="flex-1 px-4 py-6 flex flex-col gap-6">
<!-- Reliability Score Section -->
<section class="flex flex-col items-center justify-center py-4">
<div class="relative w-48 h-24 mb-4 overflow-hidden">
<!-- Semi-circle gauge background -->
<div class="absolute top-0 left-0 w-48 h-48 rounded-full border-[12px] border-slate-200 dark:border-surface-dark box-border"></div>
<!-- Semi-circle gauge value (rotated) -->
<div class="absolute top-0 left-0 w-48 h-48 rounded-full border-[12px] border-transparent border-t-accent-cyan border-r-accent-cyan box-border" style="transform: rotate(-45deg);"></div>
<div class="absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 flex flex-col items-center">
<!-- Empty spacer for absolute positioning logic -->
</div>
</div>
<div class="text-center -mt-8">
<span class="text-5xl font-bold tracking-tighter text-slate-900 dark:text-white">87</span>
<div class="flex items-center justify-center gap-1 mt-1">
<span class="material-symbols-outlined text-accent-cyan text-base">verified</span>
<p class="text-xs font-bold uppercase tracking-widest text-accent-cyan">Reliability Score</p>
</div>
</div>
</section>
<!-- Key Metrics Grid -->
<section class="grid grid-cols-3 gap-3">
<!-- Brier Score -->
<div class="bg-white dark:bg-surface-dark rounded-xl p-3 flex flex-col gap-1 border border-slate-200 dark:border-slate-800 shadow-sm">
<p class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold">Brier Score</p>
<p class="text-xl font-bold text-slate-900 dark:text-white font-mono">0.14</p>
<div class="flex items-center gap-1 text-accent-emerald text-xs font-medium">
<span class="material-symbols-outlined text-[14px]">trending_down</span>
<span>-0.02</span>
</div>
</div>
<!-- Provenance -->
<div class="bg-white dark:bg-surface-dark rounded-xl p-3 flex flex-col gap-1 border border-slate-200 dark:border-slate-800 shadow-sm">
<p class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold">Provenance</p>
<p class="text-xl font-bold text-slate-900 dark:text-white font-mono">142</p>
<div class="flex items-center gap-1 text-accent-emerald text-xs font-medium">
<span class="material-symbols-outlined text-[14px]">add</span>
<span>12</span>
</div>
</div>
<!-- Uncertainty -->
<div class="bg-white dark:bg-surface-dark rounded-xl p-3 flex flex-col gap-1 border border-slate-200 dark:border-slate-800 shadow-sm">
<p class="text-[10px] uppercase tracking-wider text-slate-500 dark:text-slate-400 font-bold">Uncertainty</p>
<p class="text-xl font-bold text-slate-900 dark:text-white font-mono">-22%</p>
<div class="flex items-center gap-1 text-accent-amber text-xs font-medium">
<span class="material-symbols-outlined text-[14px]">warning</span>
<span>High</span>
</div>
</div>
</section>
<!-- Calibration Curve -->
<section class="bg-white dark:bg-surface-dark rounded-2xl p-5 border border-slate-200 dark:border-slate-800 shadow-sm">
<div class="flex justify-between items-start mb-6">
<div>
<h3 class="text-base font-bold text-slate-900 dark:text-white">Calibration Curve</h3>
<p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Predicted vs. Actual Outcomes</p>
</div>
<div class="px-2 py-1 bg-accent-emerald/10 rounded text-accent-emerald text-xs font-bold">
                        Good Fit
                    </div>
</div>
<div class="relative w-full h-48">
<!-- Graph Background Grid -->
<div class="absolute inset-0 grid grid-cols-5 grid-rows-5 border-l border-b border-slate-200 dark:border-slate-700">
<!-- Diagonal Reference Line (Perfect Calibration) -->
<div class="absolute bottom-0 left-0 w-full h-full border-t border-dashed border-slate-300 dark:border-slate-600 origin-bottom-left" style="transform: rotate(-45deg) scale(1.414); pointer-events: none;"></div>
</div>
<!-- SVG Chart Line -->
<svg class="absolute inset-0 w-full h-full overflow-visible" preserveaspectratio="none" viewbox="0 0 100 100">
<!-- Area under curve gradient -->
<defs>
<lineargradient id="curveGradient" x1="0" x2="0" y1="0" y2="1">
<stop offset="0%" stop-color="#0dccf2" stop-opacity="0.2"></stop>
<stop offset="100%" stop-color="#0dccf2" stop-opacity="0"></stop>
</lineargradient>
</defs>
<!-- Actual User Performance Line -->
<path d="M0,100 C20,90 40,75 50,55 C60,35 80,20 100,10" fill="url(#curveGradient)" stroke="none"></path>
<path d="M0,100 C20,90 40,75 50,55 C60,35 80,20 100,10" fill="none" stroke="#0dccf2" stroke-linecap="round" stroke-width="3"></path>
<!-- Data Points -->
<circle cx="20" cy="90" fill="#101f22" r="3" stroke="#0dccf2" stroke-width="2"></circle>
<circle cx="50" cy="55" fill="#101f22" r="3" stroke="#0dccf2" stroke-width="2"></circle>
<circle cx="80" cy="20" fill="#101f22" r="3" stroke="#0dccf2" stroke-width="2"></circle>
</svg>
<!-- Labels -->
<div class="absolute -bottom-6 left-0 text-[10px] text-slate-400 font-mono">0.0</div>
<div class="absolute -bottom-6 right-0 text-[10px] text-slate-400 font-mono">1.0</div>
<div class="absolute -left-8 bottom-0 text-[10px] text-slate-400 font-mono">0.0</div>
<div class="absolute -left-8 top-0 text-[10px] text-slate-400 font-mono">1.0</div>
</div>
</section>
<!-- Contribution Heatmap -->
<section>
<div class="flex justify-between items-end mb-3">
<h3 class="text-base font-bold text-slate-900 dark:text-white">Contribution Heatmap</h3>
<div class="flex gap-3 text-[10px] font-bold uppercase tracking-wide">
<div class="flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full bg-accent-cyan"></span>
<span class="text-slate-500 dark:text-slate-400">Facts</span>
</div>
<div class="flex items-center gap-1.5">
<span class="w-2 h-2 rounded-full bg-indigo-500"></span>
<span class="text-slate-500 dark:text-slate-400">Beliefs</span>
</div>
</div>
</div>
<div class="bg-white dark:bg-surface-dark rounded-2xl p-4 border border-slate-200 dark:border-slate-800 shadow-sm overflow-x-auto hide-scrollbar">
<div class="flex flex-col gap-1 min-w-[300px]">
<!-- Days of week labels -->
<div class="flex justify-between text-[10px] text-slate-400 font-mono mb-1">
<span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span>
</div>
<!-- Week 1 -->
<div class="flex justify-between gap-1">
<div class="h-8 w-full bg-surface-darker rounded-sm"></div>
<div class="h-8 w-full bg-accent-cyan/40 rounded-sm"></div>
<div class="h-8 w-full bg-indigo-500/60 rounded-sm"></div>
