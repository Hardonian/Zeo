<div class="h-8 w-full bg-accent-cyan/30 rounded-sm"></div>
<div class="h-8 w-full bg-indigo-500/90 rounded-sm"></div>
<div class="h-8 w-full bg-accent-cyan/90 rounded-sm"></div>
<div class="h-8 w-full bg-surface-darker rounded-sm"></div>
</div>
</div>
</div>
</section>
<!-- Impact Audit List -->
<section>
<h3 class="text-base font-bold text-slate-900 dark:text-white mb-4">High-Impact Inputs</h3>
<div class="flex flex-col gap-3">
<!-- Item 1 -->
<div class="group flex items-center bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800 p-4 rounded-xl shadow-sm active:scale-[0.98] transition-transform cursor-pointer">
<div class="w-1 h-12 bg-accent-emerald rounded-full mr-4"></div>
<div class="flex-1 min-w-0">
<div class="flex items-center gap-2 mb-1">
<h4 class="text-sm font-bold text-slate-900 dark:text-white truncate">Q3 Revenue Forecast</h4>
<span class="px-1.5 py-0.5 rounded bg-accent-emerald/20 text-accent-emerald text-[10px] font-bold uppercase">Verified</span>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">Shifted probability distribution by +15%</p>
</div>
<span class="material-symbols-outlined text-slate-400 group-hover:text-primary transition-colors">chevron_right</span>
</div>
<!-- Item 2 -->
<div class="group flex items-center bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800 p-4 rounded-xl shadow-sm active:scale-[0.98] transition-transform cursor-pointer">
<div class="w-1 h-12 bg-accent-amber rounded-full mr-4"></div>
<div class="flex-1 min-w-0">
<div class="flex items-center gap-2 mb-1">
<h4 class="text-sm font-bold text-slate-900 dark:text-white truncate">APAC Market Expansion</h4>
<span class="px-1.5 py-0.5 rounded bg-accent-amber/20 text-accent-amber text-[10px] font-bold uppercase">Revision</span>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">Contradicted consensus with new signal data</p>
</div>
<span class="material-symbols-outlined text-slate-400 group-hover:text-primary transition-colors">chevron_right</span>
</div>
<!-- Item 3 -->
<div class="group flex items-center bg-white dark:bg-surface-dark border border-slate-200 dark:border-slate-800 p-4 rounded-xl shadow-sm active:scale-[0.98] transition-transform cursor-pointer">
<div class="w-1 h-12 bg-accent-cyan rounded-full mr-4"></div>
<div class="flex-1 min-w-0">
<div class="flex items-center gap-2 mb-1">
<h4 class="text-sm font-bold text-slate-900 dark:text-white truncate">Supply Chain Resilience</h4>
<span class="px-1.5 py-0.5 rounded bg-accent-cyan/20 text-accent-cyan text-[10px] font-bold uppercase">Active</span>
</div>
<p class="text-xs text-slate-500 dark:text-slate-400 line-clamp-1">Introduced 3 critical uncertainty factors</p>
</div>
<span class="material-symbols-outlined text-slate-400 group-hover:text-primary transition-colors">chevron_right</span>
</div>
</div>
</section>
<button class="w-full mt-2 py-3 bg-primary/10 hover:bg-primary/20 text-primary font-bold text-sm rounded-lg transition-colors flex items-center justify-center gap-2">
<span>View Full Audit History</span>
<span class="material-symbols-outlined text-base">history</span>
</button>
</main>
<!-- Bottom Nav (Contextual for app feel) -->
<nav class="fixed bottom-0 left-0 right-0 max-w-md mx-auto bg-background-light dark:bg-background-dark border-t border-slate-200 dark:border-slate-800 pb-safe">
