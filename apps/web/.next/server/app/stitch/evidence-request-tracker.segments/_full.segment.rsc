<div>
<p class="text-sm font-bold text-gray-800 dark:text-gray-200">Regulatory Impact EU</p>
<p class="text-[10px] font-mono text-gray-500">Legal Review • Low Priority</p>
</div>
</div>
<span class="text-xs font-mono text-gray-500">+2%</span>
</div>
<!-- List Item 2 -->
<div class="flex items-center justify-between p-3 rounded-lg bg-transparent border border-gray-200 dark:border-border-dark hover:bg-gray-50 dark:hover:bg-border-dark/30 transition-colors">
<div class="flex items-center gap-3">
<div class="w-2 h-2 rounded-full bg-gray-400"></div>
<div>
<p class="text-sm font-bold text-gray-800 dark:text-gray-200">Customer Churn Rate</p>
<p class="text-[10px] font-mono text-gray-500">Data Missing • Medium Priority</p>
</div>
</div>
<span class="text-xs font-mono text-gray-500">+4%</span>
