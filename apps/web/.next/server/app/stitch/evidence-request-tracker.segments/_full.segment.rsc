</div>
<button class="text-primary text-sm font-medium hover:underline flex items-center gap-1">
                            Details <span class="material-symbols-outlined text-sm">arrow_forward</span>
</button>
</div>
</div>
<!-- Quick Action Footer for Card -->
<div class="bg-gray-50 dark:bg-[#151c2a] px-5 py-3 border-t border-gray-200 dark:border-border-dark flex items-center justify-between">
<span class="text-xs text-gray-500">Awaiting 2 sources</span>
<button class="text-xs font-bold bg-primary hover:bg-blue-600 text-white px-4 py-2 rounded-lg transition-colors shadow-lg shadow-primary/20">
                        Upload Data
                    </button>
</div>
</div>
<!-- Card 2 (Verifying) -->
<div class="bg-white dark:bg-card-dark border border-gray-200 dark:border-border-dark rounded-xl p-5 shadow-sm relative overflow-hidden mb-4 opacity-90">
