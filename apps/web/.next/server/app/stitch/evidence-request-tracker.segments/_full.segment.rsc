</div>
</div>
</div>
</main>
<!-- Sticky Contribution Area -->
<div class="fixed bottom-0 left-0 w-full bg-white dark:bg-[#151c2a] border-t border-gray-200 dark:border-border-dark shadow-[0_-4px_20px_rgba(0,0,0,0.2)] p-4 z-40 pb-8">
