<div class="absolute left-[27px] top-6 bottom-0 w-[2px] bg-border-dark z-0"></div>
<div class="space-y-8 relative z-10">
<!-- Day Header -->
<div class="flex items-center gap-4">
<div class="w-2.5 h-2.5 rounded-full bg-primary ring-4 ring-background-dark ml-[3px]"></div>
<span class="text-xs font-mono text-text-secondary uppercase tracking-wider">Today, Oct 24</span>
</div>
<!-- Card 1: Success -->
<div class="pl-8 relative group">
<!-- Timeline Dot -->
<div class="absolute left-[5.5px] top-6 w-3 h-3 rounded-full bg-background-dark border-2 border-success z-10"></div>
<div class="bg-surface-dark border border-border-dark rounded-xl p-4 shadow-sm hover:border-primary/50 transition-colors">
<div class="flex justify-between items-start mb-2">
<div>
<div class="flex items-center gap-2 mb-1">
<span class="text-xs font-mono text-text-secondary">14:00</span>
<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wide bg-success/10 text-success border border-success/20">Success</span>
</div>
<h3 class="text-base font-bold text-white">Q3 Marketing Spend</h3>
</div>
<button class="text-text-secondary hover:text-white">
<span class="material-symbols-outlined">more_horiz</span>
</button>
</div>
<div class="space-y-3">
<div class="text-sm text-slate-300 leading-relaxed">
<span class="text-text-secondary">Path:</span> <span class="font-medium text-white">Aggressive Social Campaign</span>
</div>
