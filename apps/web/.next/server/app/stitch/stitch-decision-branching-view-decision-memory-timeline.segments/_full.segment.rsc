<span class="material-symbols-outlined text-[16px]">expand_more</span>
</button>
<button class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-dark border border-border-dark text-slate-300 text-xs font-medium shrink-0 whitespace-nowrap">
<span>Date Range</span>
<span class="material-symbols-outlined text-[16px]">calendar_today</span>
</button>
<button class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-dark border border-border-dark text-slate-300 text-xs font-medium shrink-0 whitespace-nowrap">
<span>Model: v4.2</span>
</button>
</div>
</div>
</div>
<!-- Timeline Content -->
<main class="relative px-4 py-6">
