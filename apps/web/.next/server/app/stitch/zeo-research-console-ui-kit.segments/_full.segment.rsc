f:T6cea,<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Zeo Research Console UI Kit</title>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#137fec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#0f172a",
                        "surface-dark": "#1e293b",
                        "surface-dark-hover": "#334155",
                        "border-dark": "#334155",
                    },
                    fontFamily: {
                        "display": ["Space Grotesk", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.125rem", "lg": "0.25rem", "xl": "0.5rem", "full": "0.75rem"},
                },
            },
        }
    </script>
<style>
        /* Custom scrollbar for high-density technical look */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a; 
        }
        ::-webkit-scrollbar-thumb {
            background: #334155; 
            border-radius: 2px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569; 
        }
        body {
            font-family: 'Space Grotesk', sans-serif;
        }
        .technical-grid {
            background-size: 20px 20px;
            background-image:
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 font-display min-h-screen flex flex-col overflow-hidden">
<!-- App Shell Container -->
<div class="flex flex-1 h-screen overflow-hidden">
<!-- Technical Sidebar (Collapsed Rail) -->
<aside class="w-16 bg-surface-dark border-r border-border-dark flex-col items-center py-4 hidden sm:flex z-20">
<div class="mb-8 text-primary">
<span class="material-symbols-outlined text-3xl">token</span>
</div>
<nav class="flex flex-col gap-6 w-full items-center">
<button class="text-primary bg-primary/10 p-2 rounded hover:bg-primary/20 transition-colors w-10 h-10 flex items-center justify-center">
<span class="material-symbols-outlined">dashboard</span>
</button>
<button class="text-slate-400 hover:text-white p-2 rounded hover:bg-white/5 transition-colors w-10 h-10 flex items-center justify-center">
<span class="material-symbols-outlined">science</span>
</button>
<button class="text-slate-400 hover:text-white p-2 rounded hover:bg-white/5 transition-colors w-10 h-10 flex items-center justify-center">
<span class="material-symbols-outlined">dataset</span>
</button>
<button class="text-slate-400 hover:text-white p-2 rounded hover:bg-white/5 transition-colors w-10 h-10 flex items-center justify-center">
<span class="material-symbols-outlined">settings_suggest</span>
</button>
</nav>
<div class="mt-auto flex flex-col gap-4">
<div class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_rgba(34,197,94,0.6)]"></div>
</div>
</aside>
<!-- Main Content Area -->
<div class="flex-1 flex flex-col h-full relative">
<!-- Topbar -->
<header class="h-14 bg-background-dark/95 backdrop-blur border-b border-border-dark flex items-center justify-between px-4 sticky top-0 z-10">
<div class="flex items-center gap-3">
<button class="sm:hidden text-slate-400">
<span class="material-symbols-outlined">menu</span>
</button>
<div class="flex items-center text-sm font-medium text-slate-400">
<span class="hover:text-white cursor-pointer transition-colors">Project Zeo</span>
<span class="material-symbols-outlined text-base mx-1">chevron_right</span>
<span class="hover:text-white cursor-pointer transition-colors">System</span>
<span class="material-symbols-outlined text-base mx-1">chevron_right</span>
<span class="text-white">UI Kit v1.0</span>
</div>
</div>
<div class="flex items-center gap-3">
<div class="relative hidden md:block">
<span class="material-symbols-outlined absolute left-2 top-1.5 text-slate-500 text-lg">search</span>
<input class="bg-surface-dark border border-border-dark rounded text-xs pl-8 pr-3 py-1.5 w-64 text-white placeholder-slate-500 focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-all" placeholder="Search tokens..." type="text"/>
</div>
<button class="text-slate-400 hover:text-white">
<span class="material-symbols-outlined">notifications</span>
</button>
<div class="w-6 h-6 rounded-full bg-gradient-to-br from-primary to-purple-600 border border-white/10"></div>
</div>
</header>
<!-- Scrollable Content -->
<main class="flex-1 overflow-y-auto technical-grid p-4 sm:p-6 pb-24">
<div class="max-w-4xl mx-auto space-y-8">
<!-- Header -->
<div class="flex flex-col gap-2 border-b border-border-dark pb-6">
<div class="flex items-center justify-between">
<h1 class="text-3xl font-bold tracking-tight text-white">Zeo Component System</h1>
<span class="px-2 py-0.5 rounded text-[10px] font-mono bg-primary/20 text-primary border border-primary/30 uppercase tracking-wider">v1.0.4-beta</span>
</div>
<p class="text-slate-400 text-sm max-w-2xl">
                            A high-density component library designed for epistemic clarity. Optimized for technical data entry, uncertainty visualization, and research workflows.
                        </p>
</div>
<!-- Section: Design Tokens -->
<section class="space-y-4">
<h3 class="text-xs font-mono uppercase tracking-widest text-slate-500 flex items-center gap-2">
<span class="w-2 h-2 bg-slate-500 rounded-full"></span>
                            Design Tokens
                        </h3>
<div class="bg-surface-dark border border-border-dark rounded-lg p-4 grid grid-cols-1 md:grid-cols-2 gap-6">
<!-- Colors -->
<div>
<h4 class="text-sm font-medium text-white mb-3">Palette</h4>
<div class="flex flex-wrap gap-3">
<div class="group relative">
<div class="w-10 h-10 rounded bg-primary border border-white/10 shadow-lg shadow-primary/20"></div>
<span class="text-[10px] text-slate-400 mt-1 block font-mono">Pri</span>
</div>
<div class="group relative">
<div class="w-10 h-10 rounded bg-emerald-500 border border-white/10"></div>
<span class="text-[10px] text-slate-400 mt-1 block font-mono">Suc</span>
</div>
<div class="group relative">
<div class="w-10 h-10 rounded bg-amber-500 border border-white/10"></div>
<span class="text-[10px] text-slate-400 mt-1 block font-mono">Warn</span>
</div>
<div class="group relative">
<div class="w-10 h-10 rounded bg-rose-500 border border-white/10"></div>
<span class="text-[10px] text-slate-400 mt-1 block font-mono">Err</span>
</div>
<div class="group relative">
<div class="w-10 h-10 rounded bg-[#0f172a] border border-border-dark"></div>
<span class="text-[10px] text-slate-400 mt-1 block font-mono">Bg</span>
</div>
</div>
</div>
<!-- Typography -->
<div>
<h4 class="text-sm font-medium text-white mb-3">Typography (Space Grotesk)</h4>
<div class="space-y-2">
<div class="flex items-baseline justify-between border-b border-white/5 pb-1">
<span class="text-2xl font-bold text-white">Aa</span>
<span class="text-xs font-mono text-slate-500">Bold 700</span>
</div>
<div class="flex items-baseline justify-between border-b border-white/5 pb-1">
<span class="text-xl font-medium text-white">Aa</span>
<span class="text-xs font-mono text-slate-500">Medium 500</span>
</div>
<div class="flex items-baseline justify-between">
<span class="text-lg font-normal text-white">Aa</span>
<span class="text-xs font-mono text-slate-500">Regular 400</span>
</div>
</div>
</div>
</div>
</section>
<!-- Section: KPI Cards -->
<section class="space-y-4">
<h3 class="text-xs font-mono uppercase tracking-widest text-slate-500 flex items-center gap-2">
<span class="w-2 h-2 bg-slate-500 rounded-full"></span>
                            Epistemic Indicators
                        </h3>
<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
<!-- Card 1 -->
<div class="bg-surface-dark border border-border-dark hover:border-primary/50 transition-colors rounded-lg p-4 relative group">
<div class="flex justify-between items-start mb-2">
<span class="text-xs text-slate-400 uppercase font-medium tracking-wide">P(Success)</span>
<span class="material-symbols-outlined text-slate-600 group-hover:text-primary transition-colors text-lg">timeline</span>
</div>
<div class="flex items-baseline gap-2">
<span class="text-3xl font-bold text-white tabular-nums">87.4%</span>
<span class="text-xs font-mono text-emerald-400 bg-emerald-400/10 px-1.5 py-0.5 rounded border border-emerald-400/20">▲ 2.1%</span>
</div>
<div class="mt-3 flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-amber-500"></span>
<span class="text-xs text-amber-500/80 font-mono">Uncertainty: High (±12%)</span>
</div>
</div>
<!-- Card 2 -->
<div class="bg-surface-dark border border-border-dark hover:border-primary/50 transition-colors rounded-lg p-4 relative group">
<div class="flex justify-between items-start mb-2">
<span class="text-xs text-slate-400 uppercase font-medium tracking-wide">Candidates</span>
<span class="material-symbols-outlined text-slate-600 group-hover:text-primary transition-colors text-lg">group_work</span>
</div>
<div class="flex items-baseline gap-2">
<span class="text-3xl font-bold text-white tabular-nums">1,024</span>
<span class="text-xs text-slate-500">total</span>
</div>
<div class="mt-3 w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
<div class="bg-primary h-full w-3/4 rounded-full"></div>
</div>
<div class="mt-1 flex justify-between text-[10px] text-slate-500 font-mono">
<span>Processed: 768</span>
<span>Remaining: 256</span>
</div>
</div>
<!-- Card 3 -->
<div class="bg-surface-dark border border-border-dark hover:border-primary/50 transition-colors rounded-lg p-4 relative group">
<div class="flex justify-between items-start mb-2">
<span class="text-xs text-slate-400 uppercase font-medium tracking-wide">Error Rate</span>
<span class="material-symbols-outlined text-slate-600 group-hover:text-primary transition-colors text-lg">warning</span>
</div>
<div class="flex items-baseline gap-2">
<span class="text-3xl font-bold text-white tabular-nums">0.04</span>
<span class="text-xs font-mono text-slate-500">p-value</span>
</div>
<div class="mt-3 flex flex-wrap gap-2">
<span class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-[10px] text-slate-300 font-mono">CI: 95%</span>
<span class="px-1.5 py-0.5 bg-slate-800 border border-slate-700 rounded text-[10px] text-slate-300 font-mono">N: 500</span>
</div>
</div>
</div>
</section>
<!-- Section: Badges & Status -->
<section class="space-y-4">
<h3 class="text-xs font-mono uppercase tracking-widest text-slate-500 flex items-center gap-2">
<span class="w-2 h-2 bg-slate-500 rounded-full"></span>
                            Semantic Badges
                        </h3>
<div class="bg-surface-dark border border-border-dark rounded-lg p-6 flex flex-wrap gap-4 items-center">
<!-- Success -->
<div class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-medium uppercase tracking-wide">
<span class="material-symbols-outlined text-sm">check_circle</span>
                                High Confidence
                            </div>
<!-- Warning -->
<div class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-500/10 border border-amber-500/20 text-amber-400 text-xs font-medium uppercase tracking-wide">
<span class="material-symbols-outlined text-sm">help</span>
                                Estimate
                            </div>
<!-- Error -->
<div class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs font-medium uppercase tracking-wide">
<span class="material-symbols-outlined text-sm">cancel</span>
                                Refuted
                            </div>
<!-- Neutral -->
<div class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-700/30 border border-slate-600 text-slate-300 text-xs font-medium uppercase tracking-wide">
<span class="material-symbols-outlined text-sm">info</span>
                                Candidate
                            </div>
<!-- Outline Variant -->
<div class="flex items-center gap-1.5 px-2 py-0.5 rounded border border-dashed border-slate-500 text-slate-400 text-xs font-mono">
                                Pending Peer Review
                            </div>
</div>
</section>
<!-- Section: Interactive Controls -->
<section class="space-y-4">
<h3 class="text-xs font-mono uppercase tracking-widest text-slate-500 flex items-center gap-2">
<span class="w-2 h-2 bg-slate-500 rounded-full"></span>
                            Inputs &amp; Controls
                        </h3>
<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
<!-- Input Column -->
<div class="bg-surface-dark border border-border-dark rounded-lg p-6 space-y-5">
<h4 class="text-sm font-bold text-white mb-4 border-b border-white/5 pb-2">Form Elements</h4>
<!-- Text Input -->
<div class="space-y-1.5">
<label class="text-xs text-slate-400 font-medium ml-1">Experiment ID</label>
<div class="relative">
<input class="w-full bg-background-dark border border-border-dark rounded px-3 py-2 text-sm text-white focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary font-mono transition-all" type="text" value="EXP-2023-A99"/>
<span class="material-symbols-outlined absolute right-3 top-2.5 text-slate-500 text-sm">fingerprint</span>
</div>
</div>
<!-- Input with Dropdown (Epistemic Status) -->
<div class="space-y-1.5">
<label class="text-xs text-slate-400 font-medium ml-1">Hypothesis Claim</label>
<div class="flex rounded border border-border-dark overflow-hidden focus-within:ring-1 focus-within:ring-primary focus-within:border-primary">
<select class="bg-background-dark text-xs text-amber-500 font-medium px-2 py-2 border-r border-border-dark focus:outline-none appearance-none cursor-pointer">
<option>Suspected</option>
<option>Confirmed</option>
<option>Unlikely</option>
</select>
<input class="flex-1 bg-background-dark border-none px-3 py-2 text-sm text-white focus:outline-none focus:ring-0" placeholder="Enter claim..." type="text"/>
</div>
</div>
<!-- Buttons -->
<div class="flex flex-wrap gap-3 pt-2">
<button class="bg-primary hover:bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded shadow-lg shadow-blue-500/20 transition-all active:scale-95 flex items-center gap-2">
<span class="material-symbols-outlined text-base">play_arrow</span>
                                        Run Sim
                                    </button>
<button class="bg-surface-dark-hover hover:bg-slate-600 border border-slate-600 text-white text-sm font-medium px-4 py-2 rounded transition-all active:scale-95">
                                        Cancel
                                    </button>
<button class="bg-transparent border border-rose-500/50 text-rose-500 hover:bg-rose-500/10 text-sm font-medium px-4 py-2 rounded transition-all active:scale-95 ml-auto">
                                        Prune
                                    </button>
</div>
</div>
<!-- Interactive Column -->
<div class="bg-surface-dark border border-border-dark rounded-lg p-6 space-y-6">
<h4 class="text-sm font-bold text-white mb-4 border-b border-white/5 pb-2">States &amp; Toggles</h4>
<!-- Slider -->
<div class="space-y-3">
<div class="flex justify-between items-center">
<label class="text-xs text-slate-400 font-medium">Confidence Threshold</label>
<span class="text-xs font-mono text-primary bg-primary/10 px-1.5 py-0.5 rounded">0.85</span>
</div>
<div class="relative w-full h-1 bg-slate-700 rounded-full">
<div class="absolute h-full bg-primary rounded-full" style="width: 85%"></div>
<div class="absolute top-1/2 -translate-y-1/2 w-4 h-4 bg-white rounded-full shadow cursor-pointer hover:scale-110 transition-transform" style="left: 85%; margin-left: -8px;"></div>
</div>
<div class="flex justify-between text-[10px] text-slate-600 font-mono">
<span>0.0</span>
<span>0.5</span>
<span>1.0</span>
</div>
</div>
<!-- Toggles -->
<div class="space-y-4">
<!-- Toggle Active -->
<div class="flex items-center justify-between">
<div class="flex flex-col">
<span class="text-sm text-white">Auto-Correction</span>
<span class="text-[10px] text-slate-500">Apply Bayesian updates</span>
</div>
<button class="w-10 h-5 bg-primary rounded-full relative transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-surface-dark focus:ring-primary">
<span class="absolute right-0.5 top-0.5 w-4 h-4 bg-white rounded-full shadow-sm transition-transform"></span>
</button>
</div>
<!-- Toggle Inactive -->
<div class="flex items-center justify-between">
<div class="flex flex-col">
<span class="text-sm text-slate-400">Deep Scan</span>
<span class="text-[10px] text-slate-600">Resource intensive</span>
</div>
<button class="w-10 h-5 bg-slate-700 rounded-full relative transition-colors focus:outline-none">
<span class="absolute left-0.5 top-0.5 w-4 h-4 bg-slate-400 rounded-full shadow-sm transition-transform"></span>
</button>
</div>
</div>
</div>
</div>
</section>
<!-- Section: Stepper -->
<section class="space-y-4">
<h3 class="text-xs font-mono uppercase tracking-widest text-slate-500 flex items-center gap-2">
<span class="w-2 h-2 bg-slate-500 rounded-full"></span>
                            Process Stepper
                        </h3>
<div class="bg-surface-dark border border-border-dark rounded-lg p-6 overflow-x-auto">
<div class="flex items-center min-w-[500px]">
<!-- Step 1: Complete -->
<div class="flex flex-col items-center relative z-10">
<div class="w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500 text-emerald-500 flex items-center justify-center font-bold text-sm">
<span class="material-symbols-outlined text-base">check</span>
</div>
<span class="text-xs font-medium text-emerald-500 mt-2">Draft</span>
</div>
<div class="flex-1 h-0.5 bg-emerald-500/30 mx-2 -mt-6"></div>
<!-- Step 2: Active -->
<div class="flex flex-col items-center relative z-10">
<div class="w-8 h-8 rounded-full bg-primary text-white shadow-[0_0_15px_rgba(19,127,236,0.5)] flex items-center justify-center font-bold text-sm border border-white/20">
                                        2
                                    </div>
<span class="text-xs font-bold text-white mt-2">Verify</span>
<span class="text-[10px] text-primary absolute -bottom-4 animate-pulse">Running...</span>
</div>
<div class="flex-1 h-0.5 bg-slate-700 mx-2 -mt-6"></div>
<!-- Step 3: Pending -->
<div class="flex flex-col items-center relative z-10">
<div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-600 text-slate-500 flex items-center justify-center font-bold text-sm">
                                        3
                                    </div>
<span class="text-xs font-medium text-slate-500 mt-2">Review</span>
</div>
<div class="flex-1 h-0.5 bg-slate-700 mx-2 -mt-6"></div>
<!-- Step 4: Pending -->
<div class="flex flex-col items-center relative z-10">
<div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-600 text-slate-500 flex items-center justify-center font-bold text-sm">
