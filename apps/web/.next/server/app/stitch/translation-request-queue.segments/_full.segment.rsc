f:T3655,<!DOCTYPE html>

<html class="light" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Translation Request Queue</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#137fec",
                        "background-light": "#f6f7f8",
                        "background-dark": "#101922",
                        "surface-light": "#ffffff",
                        "surface-dark": "#1a2632",
                    },
                    fontFamily: {
                        "display": ["Lexend", "sans-serif"]
                    },
                    borderRadius: {"DEFAULT": "0.25rem", "lg": "0.5rem", "xl": "0.75rem", "full": "9999px"},
                },
            },
        }
    </script>
<style>
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
  </head>
<body class="bg-background-light dark:bg-background-dark font-display text-slate-900 dark:text-slate-100 antialiased selection:bg-primary/20">
<!-- Mobile Container -->
<div class="mx-auto flex h-screen max-w-md flex-col overflow-hidden bg-background-light dark:bg-background-dark shadow-2xl md:h-[844px] md:max-h-screen md:rounded-[3rem] border-x border-slate-200 dark:border-slate-800">
<!-- Top App Bar -->
<header class="flex-none bg-surface-light dark:bg-surface-dark px-4 pb-2 pt-12 shadow-sm z-10 sticky top-0">
<div class="flex items-center justify-between mb-4">
<h1 class="text-xl font-bold tracking-tight text-slate-900 dark:text-white">Translation Queue</h1>
<button class="flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 transition-colors hover:bg-primary/10 hover:text-primary">
<span class="material-symbols-outlined text-[20px]">notifications</span>
</button>
</div>
<!-- Segmented Control -->
<div class="flex p-1 bg-slate-100 dark:bg-slate-800 rounded-lg">
<button class="flex-1 py-1.5 text-sm font-medium rounded bg-white dark:bg-slate-700 shadow-sm text-primary transition-all">My Requests</button>
<button class="flex-1 py-1.5 text-sm font-medium rounded text-slate-500 dark:text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition-all">All Requests</button>
</div>
</header>
<!-- Main Content Area -->
<main class="flex-1 overflow-y-auto hide-scrollbar pb-24">
<!-- Submit New Request (Inline Compact Form) -->
<div class="p-4 border-b border-slate-200 dark:border-slate-800 bg-surface-light dark:bg-surface-dark mb-2">
<div class="flex items-center gap-2 mb-3">
<span class="material-symbols-outlined text-primary text-[20px]">add_circle</span>
<h2 class="text-sm font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">New Request</h2>
</div>
<div class="space-y-3">
<div class="relative">
<textarea class="w-full resize-none rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 p-3 text-sm placeholder:text-slate-400 focus:border-primary focus:ring-1 focus:ring-primary dark:text-white" placeholder="Paste technical snippet here (e.g., 'Heteroskedasticity in budget report')..." rows="2"></textarea>
</div>
<div class="flex gap-2">
<select class="flex-1 appearance-none rounded-lg border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 px-3 py-2 text-xs font-medium text-slate-600 dark:text-slate-300 focus:border-primary focus:outline-none">
<option>Source: General</option>
<option>Q3 Earnings Report</option>
<option>Risk Assessment PDF</option>
<option>Engineering All-Hands</option>
</select>
<button class="bg-primary text-white rounded-lg px-4 py-2 text-xs font-bold hover:bg-blue-600 transition-colors shadow-sm shadow-primary/30">
                            Submit
                        </button>
</div>
</div>
</div>
<!-- Priority Queue List -->
<div class="px-4 py-4">
<div class="flex items-center justify-between mb-3">
<h3 class="text-base font-bold text-slate-900 dark:text-white">Active Queue</h3>
<div class="flex gap-1 text-xs font-medium text-slate-500">
<span>Sort by:</span>
<span class="text-primary cursor-pointer">Priority</span>
</div>
</div>
<div class="space-y-3">
<!-- Card 1: High Priority, Pending -->
<div class="group relative flex flex-col gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-surface-light dark:bg-surface-dark p-4 shadow-sm transition-all hover:shadow-md hover:border-primary/50">
<div class="flex items-start justify-between">
<div class="flex items-center gap-2">
<span class="flex h-2 w-2 rounded-full bg-red-500 shadow-[0_0_8px_rgba(239,68,68,0.6)]"></span>
<span class="text-[10px] font-bold uppercase tracking-wide text-red-500">High Priority</span>
</div>
<span class="rounded-full bg-yellow-100 dark:bg-yellow-900/30 px-2 py-0.5 text-[10px] font-bold text-yellow-700 dark:text-yellow-400 border border-yellow-200 dark:border-yellow-800">Pending</span>
</div>
<p class="text-sm font-medium leading-snug text-slate-900 dark:text-slate-100">
                            "What does 'Stochastic Volatility' imply for the Q4 projection models?"
                        </p>
<div class="mt-1 flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-2">
<div class="flex items-center gap-1 text-xs text-slate-500">
<span class="material-symbols-outlined text-[14px]">description</span>
<span>Q4 Outlook PDF</span>
</div>
<span class="text-[10px] text-slate-400">2h ago</span>
</div>
</div>
<!-- Card 2: Medium Priority, In Progress -->
<div class="group relative flex flex-col gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-surface-light dark:bg-surface-dark p-4 shadow-sm transition-all hover:shadow-md">
<div class="flex items-start justify-between">
<div class="flex items-center gap-2">
<span class="flex h-2 w-2 rounded-full bg-orange-400"></span>
<span class="text-[10px] font-bold uppercase tracking-wide text-orange-400">Medium</span>
</div>
<span class="rounded-full bg-primary/10 dark:bg-primary/20 px-2 py-0.5 text-[10px] font-bold text-primary border border-primary/20">In Progress</span>
</div>
<p class="text-sm font-medium leading-snug text-slate-900 dark:text-slate-100">
                            "Clarification on 'Delta Hedging' strategy mentioned in risk mitigation slide."
                        </p>
<div class="mt-1 flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-2">
<div class="flex items-center gap-1 text-xs text-slate-500">
<span class="material-symbols-outlined text-[14px]">slideshow</span>
<span>Risk Deck v2</span>
</div>
<div class="flex -space-x-2">
<img alt="Avatar" class="h-6 w-6 rounded-full border-2 border-white dark:border-slate-800 object-cover" data-alt="User avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCWqDN7iNK_hT1lw-0ARLxnQ2IsLtGsH6UablH_NVokVdxComfqv2TW5OvbUwnriQ1y4UcM12OlNtaISdUcXpkFXKpahYN_5JsG1y1rGuTUihepxaxUu324T34BYrvQenGZQKY90wKa6vdUEvXpevNHe99_K8Jw8sx1OIODg_3ozOLS6ObAplHqghK0ybKPjmKOyCuwffZInPuZyigbgJTfnSR2War8WXVQZQJKcLCGoiQxPjbdtWdHYCCMCrEKkP_DnPzcssfu60GK"/>
<div class="flex h-6 w-6 items-center justify-center rounded-full border-2 border-white dark:border-slate-800 bg-slate-100 text-[8px] font-bold text-slate-600">+1</div>
</div>
</div>
</div>
<!-- Card 3: Low Priority, Pending -->
<div class="group relative flex flex-col gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-surface-light dark:bg-surface-dark p-4 shadow-sm transition-all hover:shadow-md">
<div class="flex items-start justify-between">
<div class="flex items-center gap-2">
<span class="flex h-2 w-2 rounded-full bg-slate-400"></span>
<span class="text-[10px] font-bold uppercase tracking-wide text-slate-400">Low</span>
</div>
<span class="rounded-full bg-yellow-100 dark:bg-yellow-900/30 px-2 py-0.5 text-[10px] font-bold text-yellow-700 dark:text-yellow-400 border border-yellow-200 dark:border-yellow-800">Pending</span>
</div>
<p class="text-sm font-medium leading-snug text-slate-900 dark:text-slate-100">
                            "Definition of 'Idiosyncratic Risk' within the context of the new portfolio allocation."
                        </p>
<div class="mt-1 flex items-center justify-between border-t border-slate-100 dark:border-slate-800 pt-2">
<div class="flex items-center gap-1 text-xs text-slate-500">
<span class="material-symbols-outlined text-[14px]">table_chart</span>
<span>Portfolio Sheet</span>
</div>
<span class="text-[10px] text-slate-400">Yesterday</span>
</div>
</div>
</div>
</div>
<!-- Community Definitions Section -->
<div class="mt-2 bg-slate-50 dark:bg-slate-800/50 pb-8 pt-6">
<div class="px-4 mb-3 flex justify-between items-end">
<div>
<h3 class="text-base font-bold text-slate-900 dark:text-white">Community Definitions</h3>
<p class="text-xs text-slate-500">Recently resolved translations</p>
</div>
<a class="text-xs font-bold text-primary hover:text-blue-600" href="#">View All</a>
</div>
<!-- Horizontal Scroll Container -->
<div class="flex gap-4 overflow-x-auto px-4 pb-4 hide-scrollbar snap-x snap-mandatory">
<!-- Def Card 1 -->
<div class="snap-center shrink-0 w-[280px] rounded-xl bg-white dark:bg-slate-700 p-4 shadow-sm border border-slate-200 dark:border-slate-600">
<div class="flex items-center justify-between mb-2">
<span class="text-xs font-bold text-primary bg-primary/10 px-2 py-1 rounded">Resolved</span>
<span class="material-symbols-outlined text-green-500 text-[18px]">check_circle</span>
</div>
<h4 class="font-bold text-slate-900 dark:text-white mb-1">Alpha Decay</h4>
<p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                            The decline in the effectiveness of a trading strategy over time as the market adapts to it.
                        </p>
<div class="mt-3 flex items-center gap-2">
<img class="h-5 w-5 rounded-full object-cover" data-alt="Expert avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBz_bH_3Ho4AxHGIjiJP72eV8F2C5SuXUw0gktzYuYyMfuf7IV0UD5Ygfg-oB68xSoHWqZF4FyUm-rq1OmBA0Qkbg-2ruamkdoQWkX-EIbXO0sntRyN-hBMBHGBZrkZeQJvPK3xomE6FFyoaDOwF_U3SvrXLTBzHW6NmhFrPY64QMQRDeffyMFle4Dayla880_nRhaWnZJCKHF-5mZPBwyrvB8UX9gxIsVl8y37FBWpaeGs79HrL2x6tm8auqUEt9865YHkKr2yGA6B"/>
<span class="text-[10px] text-slate-400">Answered by Dr. Chen</span>
</div>
</div>
<!-- Def Card 2 -->
<div class="snap-center shrink-0 w-[280px] rounded-xl bg-white dark:bg-slate-700 p-4 shadow-sm border border-slate-200 dark:border-slate-600">
<div class="flex items-center justify-between mb-2">
<span class="text-xs font-bold text-primary bg-primary/10 px-2 py-1 rounded">Resolved</span>
<span class="material-symbols-outlined text-green-500 text-[18px]">check_circle</span>
</div>
<h4 class="font-bold text-slate-900 dark:text-white mb-1">Sharpe Ratio</h4>
<p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300">
                            A measure of risk-adjusted return. Higher is better, indicating more return per unit of risk taken.
                        </p>
<div class="mt-3 flex items-center gap-2">
<img class="h-5 w-5 rounded-full object-cover" data-alt="Expert avatar" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB7drfybdcuJL84qAGSOzfNuUM1BCItUqbF6rU3sXzCg8F-zcEqrzuD25rJ5bJ2tYCcHJMxK2Km5_BFV7igm7Budc26a8EwvOeN1xk7xaXF3GInEaYM_58AP0jRpe3Tqe-Uxu-bAaDPl001qhfB3mmSeGMuDE1vg4JcEbPePmL7Jxc-M0usq0C2X_rZEjGyZJVztqwuLTHDNb9ycI-u4S9IpmXL3ycQPBeIpADGSMc9vPIDjudr-chPB2tkh_EPf29aCPYIXqZSZ3He"/>
<span class="text-[10px] text-slate-400">Answered by Sarah J.</span>
</div>
</div>
</div>
</div>
</main>
<!-- Bottom Tab Bar (iOS Style) -->
<nav class="flex-none bg-surface-light/90 dark:bg-surface-dark/90 backdrop-blur-md border-t border-slate-200 dark:border-slate-800 pb-5 pt-2 px-6 flex justify-between items-center z-20">
<button class="flex flex-col items-center gap-1 text-primary">
<span class="material-symbols-outlined filled">queue_music</span>
