{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@prisma/client": [
        "../../packages/db/src/prisma-client.d.ts"
      ],
      "@zeo/budgets": [
        "../../packages/budgets/src/index.ts"
      ],
      "@zeo/calibration": [
        "../../packages/calibration/src/index.ts"
      ],
      "@zeo/causal": [
        "../../packages/causal/src/index.ts"
      ],
      "@zeo/contracts": [
        "../../packages/contracts/src/index.ts"
      ],
      "@zeo/core": [
        "../../packages/core/src/index.ts"
      ],
      "@zeo/counterfactuals": [
        "../../packages/counterfactuals/src/index.ts"
      ],
      "@zeo/db": [
        "../../packages/db/src/index.ts"
      ],
      "@zeo/eval": [
        "../../packages/eval/src/index.ts"
      ],
      "@zeo/game": [
        "../../packages/game/src/index.ts"
      ],
      "@zeo/governance": [
        "../../packages/governance/src/index.ts"
      ],
      "@zeo/id": [
        "../../packages/id/src/index.ts"
      ],
      "@zeo/jobs": [
        "../../packages/jobs/src/index.ts"
      ],
      "@zeo/kpi": [
        "../../packages/kpi/src/index.ts"
      ],
      "@zeo/memory": [
        "../../packages/memory/src/index.ts"
      ],
      "@zeo/models": [
        "../../packages/models/src/index.ts"
      ],
      "@zeo/nl": [
        "../../packages/nl/src/index.ts"
      ],
      "@zeo/radar": [
        "../../packages/radar/src/index.ts"
      ],
      "@zeo/reality": [
        "../../packages/reality/src/index.ts"
      ],
      "@zeo/regimes": [
        "../../packages/regimes/src/index.ts"
      ],
      "@zeo/repro-pack": [
        "../../packages/repro-pack/src/index.ts"
      ],
      "@zeo/rsl": [
        "../../packages/rsl/src/index.ts"
      ],
      "@zeo/signal-discovery": [
        "../../packages/signal-discovery/src/index.ts"
      ],
      "@zeo/telemetry": [
        "../../packages/telemetry/src/index.ts"
      ],
      "@zeo/timeseries": [
        "../../packages/timeseries/src/index.ts"
      ],
      "@zeo/policy-types": [
        "../../packages/policy-types/src/index.ts"
      ],
      "@zeo/trust": [
        "../../packages/trust/src/index.ts"
      ],
      "@zeo/warehouse": [
        "../../packages/warehouse/src/index.ts"
      ],
      "@zeo/compliance": [
        "../../packages/compliance/src/index.ts"
      ],
      "@zeo/modules": [
        "../../packages/modules/src/index.ts"
      ],
      "@zeo/observability": [
        "../../packages/observability/src/index.ts"
      ],
      "@zeo/optimization": [
        "../../packages/optimization/src/index.ts"
      ],
      "@zeo/schema-registry": [
        "../../packages/schema-registry/src/index.ts"
      ],
      "@zeo/simulation": [
        "../../packages/simulation/src/index.ts"
      ],
      "@zeo/tenant": [
        "../../packages/tenant/src/index.ts"
      ]
    },
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "src/types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
