{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@zeo/contracts": ["packages/contracts/src"],
      "@zeo/adapters": ["packages/adapters/src"],
      "@zeo/warehouse": ["packages/warehouse/src"],
      "@zeo/analytics": ["packages/analytics/src"],
      "@zeo/dataset-builder": ["packages/dataset-builder/src"],
      "@zeo/replay": ["packages/replay/src"],
      "@zeo/regimes": ["packages/regimes/src"],
      "@zeo/core": ["packages/core/src"],
      "@zeo/models": ["packages/models/src"],
      "@zeo/governance": ["packages/governance/src"]
    }
  }
}
