# Zeo environment variables (example)
# Do not commit real secrets. Copy to .env locally.

# --- Required for apps/web webhook verification ---
GITHUB_WEBHOOK_SECRET=

# --- Optional GitHub App integration ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=

# --- Optional model providers (CLI + automation) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Optional vendor keys (used only if adapters are enabled) ---
OCR_VENDOR_KEY=
STT_VENDOR_KEY=
MARKET_DATA_KEY=
NEWS_DATA_KEY=

# --- Supabase auth (required for hosted OAuth consent) ---
NEXT_PUBLIC_SUPABASE_URL=https://qtwpbyrdvrxfpbiajqos.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime
NODE_ENV=development

# --- Optional local Dynamo cache mesh ---
# ZEO_DYNAMO_URL=http://127.0.0.1:8000
# ZEO_DYNAMO_AUTH_TOKEN=
# ZEO_DYNAMO_MODEL=
# ZEO_LOCAL_ENGINE_URL=http://127.0.0.1:30000
# ZEO_SPECULATIVE_PREFILL_THRESHOLD_MS=750
# ZEO_DYNAMO_TIMEOUT_MS=30000
# ZEO_DYNAMO_CIRCUIT_FAILURE_THRESHOLD=3
# ZEO_DYNAMO_CIRCUIT_COOLDOWN_MS=15000
# ZEO_PREFIX_REGISTRY_LIMIT=2048

# --- Optional frontier fallback for the cache mesh ---
# ZEO_CLOUD_GATEWAY_URL=
# ZEO_CLOUD_AUTH_TOKEN=
# ZEO_CLOUD_MODEL=
# ZEO_CLOUD_TIMEOUT_MS=60000
