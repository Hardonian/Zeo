{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@controlplane/contract-kit": [
        "../contract-kit/src/index.ts",
        "../contract-kit/dist/index.d.ts"
      ],
      "@controlplane/observability": [
        "../observability/src/index.ts",
        "../observability/dist/index.d.ts"
      ],
      "@controlplane/contracts": [
        "../contracts/src/index.ts",
        "../contracts/dist/index.d.ts"
      ]
    },
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
