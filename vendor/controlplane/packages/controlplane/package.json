{
  "name": "@controlplane/controlplane",
  "version": "1.0.0",
  "description": "ControlPlane orchestration CLI and SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "controlplane": "./bin/controlplane.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "node ../../scripts/build-target.mjs @controlplane/contracts @controlplane/observability @controlplane/contract-kit -- tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "lint": "node ../../scripts/lint-target.mjs vendor/controlplane/packages/controlplane/src",
    "test": "pnpm --filter @controlplane/contracts build && pnpm --filter @controlplane/observability build && pnpm --filter @controlplane/contract-kit build && vitest run"
  },
  "dependencies": {
    "@controlplane/contract-kit": "workspace:*",
    "@controlplane/observability": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "eslint": "^8.55.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "Apache-2.0"
}
