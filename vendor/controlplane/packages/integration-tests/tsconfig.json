{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@controlplane/contract-kit": [
        "../contract-kit/src/index.ts"
      ],
      "@controlplane/controlplane": [
        "../controlplane/src/index.ts"
      ],
      "@controlplane/observability": [
        "../observability/src/index.ts"
      ],
      "@controlplane/contracts": [
        "../contracts/src/index.ts"
      ]
    }
  },
  "include": [
    "../../tests/integration/**/*.ts",
    "../../tests/integration/**/*.d.ts"
  ]
}
