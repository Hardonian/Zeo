{
  "name": "zeo",
  "private": true,
  "version": "1.0.0",
  "description": "Zeo — Decision intelligence under uncertainty",
  "license": "MIT",
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.15.5"
  },
  "volta": {
    "node": "20.19.0",
    "pnpm": "9.15.5"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "zeo": "node scripts/zeo.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:cache-mesh:live": "node scripts/cache-mesh-live-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "doctor:secrets": "node scripts/doctor.mjs",
    "build": "pnpm -r --workspace-concurrency=3 build",
    "typecheck": "pnpm -C packages/contracts build && pnpm -C vendor/controlplane/packages/contracts build && pnpm -r typecheck && pnpm -C packages/core typecheck:exports",
    "ci:gate": "pnpm run typecheck && pnpm build && node scripts/startup-profiler.mjs && pnpm zeo benchmark --budget-analysis-p95=50 --budget-policy-p95=10 && pnpm zeo audit --dry-run",
    "test": "pnpm -C packages/contracts build && node scripts/run-pnpm-with-node-options.mjs -r --workspace-concurrency=1 test",
    "test:ci": "echo 'Running fast tests...' && node scripts/run-pnpm-with-node-options.mjs -r --filter !@zeo/core --filter !@zeo/warehouse --filter !@zeo/repro-pack test && echo 'Running heavy tests sequentially...' && node scripts/run-pnpm-with-node-options.mjs -r --filter @zeo/core --filter @zeo/warehouse --filter @zeo/repro-pack --workspace-concurrency=1 test",
    "lint": "pnpm -r lint",
    "verify": "pnpm check:imports && pnpm lint && pnpm typecheck && pnpm build && pnpm test:seo && pnpm test:a11y && pnpm test:security && pnpm test:perf && pnpm test:db",
    "verify:fast": "pnpm run doctor && pnpm check:imports && pnpm run typecheck && pnpm run test && pnpm run lint",
    "verify:full": "pnpm install --frozen-lockfile && pnpm run build && pnpm run verify && pnpm audit && pnpm doctor:secrets",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "eval": "pnpm -C apps/cli eval",
    "version:stamp": "node scripts/stamp-version.js",
    "mcp:server": "node packages/mcp-server/dist/index.js",
    "mcp:server:http": "node packages/mcp-server/dist/index.js --http",
    "mcp:doctor": "node packages/mcp-server/dist/doctor.js",
    "quickstart:web": "pnpm install && pnpm -r build && pnpm -C apps/web dev",
    "quickstart:cli": "pnpm install && pnpm -r build && pnpm -C apps/cli start -- --example negotiation",
    "quickstart:demo": "pnpm install && pnpm -r build && pnpm -C apps/cli start -- --replay ../../external/examples/replay/sample_dataset.json --report-out ./reports",
    "quickstart:all": "pnpm verify:full && echo '=== Quickstart: CLI ===' && pnpm quickstart:cli && echo '=== Quickstart: Demo ===' && pnpm quickstart:demo",
    "cli:perf": "node scripts/cli-perf.mjs",
    "mcp:smoke": "node scripts/mcp-smoke.mjs",
    "fixtures:coverage": "node scripts/fixture-coverage.mjs",
    "perf:budget": "node scripts/perf-budget.mjs",
    "validate:ecosystem": "node scripts/validate-ecosystem.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:licenses": "node scripts/license-check.mjs",
    "deps:dry-run": "node scripts/dependency-upgrade-dry-run.mjs",
    "clean": "node -e \"const fs=require('fs');const p=require('path');for(const t of ['node_modules','.turbo','.pnpm-store'])fs.rmSync(p.resolve(t),{recursive:true,force:true});\"",
    "ci:install": "pnpm install --frozen-lockfile",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "mcp:smoke:docker": "node scripts/mcp-smoke-docker.mjs",
    "docker:size:assert": "node scripts/docker-size-assert.mjs",
    "test:seo": "node scripts/with-web-server.mjs node scripts/seo-audit.mjs",
    "test:a11y": "pnpm -C apps/web test:a11y",
    "test:security": "node scripts/with-web-server.mjs node scripts/security-audit.mjs",
    "test:perf": "node scripts/perf-web-budget.mjs",
    "test:db": "node scripts/db-guardrails.mjs",
    "test:headers": "node scripts/with-web-server.mjs node scripts/headers-audit.mjs",
    "test:eval": "node scripts/eval-golden.mjs",
    "rls:index-audit": "node scripts/rls-index-audit.mjs",
    "deps:update": "node scripts/dependency-update-report.mjs",
    "workflows": "./scripts/workflows.sh",
    "cheatsheet:generate": "node scripts/generate-command-cheatsheet.mjs",
    "tdd:smoke": "node scripts/tdd-smoke-report.mjs",
    "refactor:board": "node scripts/extract-refactor-todos.mjs",
    "task:inbox": "node scripts/task-inbox.mjs",
    "issues:from-meeting": "node scripts/meeting-notes-to-issues.mjs",
    "docs:api-snippets": "node scripts/generate-api-snippets.mjs",
    "changelog:generate": "node scripts/generate-changelog-section.mjs",
    "ai:test-generate": "node scripts/generate-ai-tests.mjs",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "test:golden": "node scripts/golden-harness.mjs --lane=main",
    "test:golden:pr": "node scripts/golden-harness.mjs --lane=pr",
    "mcp:smoke:example": "node examples/mcp/stdio-smoke-client.mjs",
    "bench:run": "node bench/run-benchmarks.mjs --lane=main",
    "bench:run:pr": "node bench/run-benchmarks.mjs --lane=pr",
    "boundary:check": "node scripts/boundary-check.mjs",
    "check:imports": "pnpm boundary:check",
    "eval:principles": "node scripts/eval-zeo-principles.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.10.0",
    "globals": "^17.12.0",
    "js-yaml": "^5.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "keywords": [
    "decision-intelligence",
    "uncertainty",
    "epistemology",
    "negotiation",
    "operations",
    "branching-analysis",
    "open-source"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Hardonian/Zeo.git"
  },
  "bugs": {
    "url": "https://github.com/Hardonian/Zeo/issues"
  },
  "homepage": "https://github.com/Hardonian/Zeo#readme"
}
