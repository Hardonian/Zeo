{
  "name": "zeo",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "verify": "pnpm run typecheck && pnpm run test && pnpm run lint",
    "verify:full": "pnpm install && pnpm run build && pnpm run verify && pnpm audit",
    "audit": "pnpm audit --audit-level=moderate",
    "audit:fix": "pnpm audit --fix",
    "eval": "pnpm -C apps/cli eval"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "eslint": "^9.10.0",
    "globals": "^15.9.0",
    "js-yaml": "^4.1.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^2.1.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": ">=0.25.0",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "next@>=10.0.0 <15.5.10": ">=15.5.10",
      "next@>=13.0.0 <15.0.8": ">=15.0.8"
    }
  }
}