{
  "name": "@zeo/eval",
  "version": "0.5.1",
  "description": "Evaluation harness for epistemic regressions and determinism checks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runner": {
      "types": "./dist/runner.d.ts",
      "import": "./dist/runner.js"
    },
    "./invariants": {
      "types": "./dist/invariants.d.ts",
      "import": "./dist/invariants.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zeo/contracts": "workspace:*",
    "@zeo/core": "workspace:*",
    "@zeo/replay": "workspace:*",
    "@zeo/tournaments": "workspace:*",
    "@zeo/calibration": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.1"
  }
}
