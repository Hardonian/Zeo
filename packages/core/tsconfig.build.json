{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "src",
    "baseUrl": "../..",
    "paths": {
      "@zeo/models": [
        "packages/models/src"
      ],
      "@zeo/id": [
        "packages/id/src"
      ],
      "@zeo/db": [
        "packages/db/src"
      ],
      "@prisma/client": [
        "packages/db/src/prisma-client.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ]
}