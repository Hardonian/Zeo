{
  "name": "@zeo/reality",
  "version": "0.7.0",
  "description": "Reality Mode: Secure sharing of packets and datasets with redaction policies and access control",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "import": "./dist/share.js"
    },
    "./acl": {
      "types": "./dist/acl.d.ts",
      "import": "./dist/acl.js"
    },
    "./redaction": {
      "types": "./dist/redaction.d.ts",
      "import": "./dist/redaction.js"
    },
    "./crypto": {
      "types": "./dist/crypto.d.ts",
      "import": "./dist/crypto.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zeo/contracts": "workspace:*",
    "@zeo/core": "workspace:*",
    "@zeo/trust": "workspace:*",
    "@zeo/audit": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.1",
    "@types/node": "^20.0.0"
  }
}
