{
  "name": "@zeo/dataset-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @zeo/adapters build && pnpm --filter @zeo/warehouse build && vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@zeo/adapters": "workspace:*",
    "@zeo/contracts": "workspace:*",
    "@zeo/warehouse": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
