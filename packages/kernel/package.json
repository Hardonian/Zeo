{
  "name": "@zeo/kernel",
  "version": "1.0.0",
  "description": "Pure logic kernel for Zeo — Decision Engine, Probability, and State Machines. Runtime-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@zeo/contracts": "workspace:*",
    "nanoid": "^6.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^5.0.0"
  }
}
