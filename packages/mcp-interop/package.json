{
    "name": "@zeo/mcp-interop",
    "version": "1.4.0",
    "private": true,
    "type": "module",
    "description": "Notebook-friendly interchange format for Zeo MCP integration",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "eslint src"
    },
    "dependencies": {
        "@zeo/contracts": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.2.1",
        "vitest": "^2.1.1"
    }
}