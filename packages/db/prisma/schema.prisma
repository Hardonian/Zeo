generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  // Relations
  repositories         Repository[]
  runs                 ReadyLayerRun[]
  evidenceAttestations EvidenceAttestation[]
  evidenceObjects      EvidenceObject[]
  policyPacks          PolicyPack[]
  policyAssignments    PolicyPackAssignment[]
  webhookReceipts      WebhookReceipt[]
}

model Repository {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  projects     Project[]

  // Relations
  runs                 ReadyLayerRun[]
  evidenceAttestations EvidenceAttestation[]
  policyAssignments    PolicyPackAssignment[]
}

model Project {
  id           String @id @default(cuid())
  repositoryId String
  name         String

  repository Repository @relation(fields: [repositoryId], references: [id])
}

model ReadyLayerRun {
  id             String   @id @default(cuid())
  organizationId String
  repositoryId   String
  status         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  repository   Repository   @relation(fields: [repositoryId], references: [id])

  attestations EvidenceAttestation[]
}

model EvidenceAttestation {
  id             String   @id @default(cuid())
  organizationId String
  repositoryId   String
  runId          String
  manifestHash   String
  bundleHash     String
  treeHash       String
  signingMode    String // "none" | "hmac" | "ed25519"
  signature      String?
  publicKeyId    String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id])
  repository   Repository    @relation(fields: [repositoryId], references: [id])
  run          ReadyLayerRun @relation(fields: [runId], references: [id])

  @@unique([runId])
  @@index([organizationId])
  @@index([repositoryId])
}

model EvidenceObject {
  id              String   @id @default(cuid())
  organizationId  String
  runId           String? // Optional link if not strictly tied to run at creation
  kind            String // "zip" | "manifest" | "policyPack" | "sarif" | "report" | "other"
  storageProvider String // "db" | "s3" | "gcs" | "local"
  storageKey      String
  sizeBytes       Int
  contentHash     String
  createdAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model PolicyPack {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  version        String
  description    String?
  contentsJson   String // Storing JSON as string for SQLite compatibility/simplicity
  packHash       String
  signature      String?
  signingMode    String // "none" | "hmac" | "ed25519"
  createdAt      DateTime @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id])
  assignments  PolicyPackAssignment[]

  @@unique([organizationId, name, version])
}

model PolicyPackAssignment {
  id             String   @id @default(cuid())
  organizationId String
  repositoryId   String?
  scope          String // "org" | "repo"
  policyPackId   String
  enabled        Boolean
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  repository   Repository?  @relation(fields: [repositoryId], references: [id])
  policyPack   PolicyPack   @relation(fields: [policyPackId], references: [id])

  @@index([organizationId])
  @@index([repositoryId])
}

model WebhookReceipt {
  id             String   @id @default(cuid())
  organizationId String
  provider       String // "github" | "gitlab" | "bitbucket" | "custom"
  deliveryId     String
  receivedAt     DateTime @default(now())
  bodyHash       String
  signatureValid Boolean
  replayBlocked  Boolean
  processed      Boolean
  correlationId  String?

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, provider, deliveryId])
}

model DeadLetterJob {
  id           String   @id @default(cuid())
  jobId        String
  jobType      String
  payloadJson  String
  errorCode    String
  failureClass String // "transient" | "permanent"
  errorMessage String
  attempts     Int
  createdAt    DateTime @default(now())
  lastFailedAt DateTime

  @@index([jobType])
  @@index([createdAt])
}
