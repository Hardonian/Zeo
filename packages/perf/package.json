{
  "name": "@zeo/perf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Performance profiling and hot path identification for Zeo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "echo 'No source files to lint'"
  },
  "dependencies": {
    "@zeo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.1"
  },
  "keywords": [
    "performance",
    "profiling",
    "hot-path",
    "static-analysis",
    "optimization"
  ]
}
