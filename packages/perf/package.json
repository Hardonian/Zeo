{
  "name": "@zeo/perf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Performance profiling and hot path identification for Zeo",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/run-pnpm-with-node-options.mjs --heap-mb=8192 exec vitest run --pool=threads --maxWorkers=1",
    "lint": "echo 'No source files to lint'"
  },
  "dependencies": {
    "@zeo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2"
  },
  "keywords": [
    "performance",
    "profiling",
    "hot-path",
    "static-analysis",
    "optimization"
  ]
}
