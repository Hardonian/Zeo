{
  "name": "@zeo/adapters-runtime",
  "version": "0.5.2",
  "description": "Adapter runtime with fetch orchestration, caching, rate limiting, and data poisoning defense",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@zeo/contracts": "workspace:*",
    "@zeo/warehouse": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
