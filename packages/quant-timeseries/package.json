{
    "name": "@zeo/quant-timeseries",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Robust time-series toolkit: change-point detection (BOCPD/PELT), Kalman filtering, state-space smoothing",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "lint": "eslint src"
    },
    "dependencies": {
        "@zeo/contracts": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.2.1"
    }
}